-- ================= SERVICES =================
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")

if not RunService:IsClient() then
	warn("[CAF] ERROR: server side. Must be a LocalScript in StarterPlayerScripts.")
	return
end

warn("[CAF] boot: client side OK")

local player = Players.LocalPlayer
if not player then return end

-- ================= CONFIG (tune everything here) =================
local CONFIG = {
	ParticleTexture = "",          -- "" = no download (404-proof). Or "rbxassetid://YOUR_OWN_ID"
	WalkSpeed = 16,   JumpVel = 50,
	SlowSpeed = 6,    SlowJump = 20,
	OverSpeed = 42,   OverJump = 85,
	NoClipSpeed = 65,
	MaxStacks = 12,                -- Aura Loop max +speed stacks
	StackRate = 0.8,               -- stacks per second
	RegenPerSec = 2,               -- Aura Shield heal
	Toasts = true,
}

local QUALITY = UserInputService.TouchEnabled and 0.6 or 1  -- fewer particles on mobile

-- ================= FONT SAFETY =================
local validFonts = {}
for _, f in ipairs(Enum.Font:GetEnumItems()) do validFonts[f.Name] = f end
local function pickFont(names)
	for _, n in ipairs(names) do
		if validFonts[n] then return validFonts[n] end
	end
	return Enum.Font:GetEnumItems()[1]
end
local FONT_BLACK = pickFont({"GothamBlack", "SourceSansBold", "ArialBold", "Bold"})
local FONT_SEMI  = pickFont({"GothamSemiBold", "SourceSansSemibold", "SourceSansBold", "ArialBold", "Bold"})
local FONT_BOLD  = pickFont({"GothamBold", "SourceSansBold", "ArialBold", "Bold"})

-- ================= STATE =================
local states = {
	SlowMo = false, Ragdoll = false, NoClip = false, AirJump = false,
	Shield = false, Overdrive = false, AuraLoop = false, Cinematic = false,
	Domain = false, TimeSkip = false,
}
local noclipUp = false
local noclipDown = false
local toggles = {}
local cdEntries = {}
local burstToken = 0
local domainToken = 0
local tsToken = 0
local auraStacks = 0
local flareUntil = 0
local flareActive = false
local dogeCD = 0
local lastHint = 0

local ACCENT = Color3.fromRGB(190, 130, 255)
local GREEN = Color3.fromRGB(90, 255, 170)
local BTN_BG = Color3.fromRGB(52, 56, 78)
local BTN_STROKE = Color3.fromRGB(95, 100, 130)

-- ================= CORE HELPERS =================
local function getCharacter()
	local char = player.Character
	if not char then return nil, nil, nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")
	if not hum or not root then return nil, nil, nil end
	return char, hum, root
end

local function setJumpVelocity(hum, vel)
	if hum.UseJumpPower then
		hum.JumpPower = vel
	else
		hum.JumpHeight = (vel * vel) / (2 * math.max(workspace.Gravity, 1))
	end
end

local function getJumpVelocity(hum)
	if hum.UseJumpPower then return hum.JumpPower end
	return math.sqrt(2 * math.max(workspace.Gravity, 1) * hum.JumpHeight)
end

local function currentFOV()
	if states.Cinematic then return 42 end
	if states.TimeSkip then return 50 end
	if states.Overdrive then return 82 end
	if states.SlowMo then return 56 end
	return 70
end

local function tweenFOV(target, time)
	local cam = workspace.CurrentCamera
	if not cam then return end
	TweenService:Create(cam, TweenInfo.new(time or 0.3), {FieldOfView = target}):Play()
end

local function refreshMovement()
	local char, hum, root = getCharacter()
	if not hum then return end
	if states.Ragdoll then
		hum.WalkSpeed = 0
		setJumpVelocity(hum, 0)
		return
	end
	local speed, jump
	if states.TimeSkip then speed, jump = 4, 12
	elseif states.Overdrive then speed, jump = CONFIG.OverSpeed, CONFIG.OverJump
	elseif states.SlowMo then speed, jump = CONFIG.SlowSpeed, CONFIG.SlowJump
	else speed, jump = CONFIG.WalkSpeed, CONFIG.JumpVel end
	if states.Domain then
		speed = math.floor(speed * 1.35)
		jump = jump + 8
	end
	speed = speed + math.floor(auraStacks)
	if os.clock() < flareUntil then speed = speed + 10 end
	hum.WalkSpeed = speed
	setJumpVelocity(hum, jump)
end

local function setSlowVisual(on)
	if on then
		local cc = Lighting:FindFirstChild("CAFSlowCC")
		if not cc then
			cc = Instance.new("ColorCorrectionEffect")
			cc.Name = "CAFSlowCC"
			cc.Parent = Lighting
		end
		cc.Contrast = 0.18
		cc.Saturation = 0.08
		cc.Brightness = 0.02
		cc.TintColor = Color3.fromRGB(215, 230, 255)
		local blur = Lighting:FindFirstChild("CAFSlowBlur")
		if not blur then
			blur = Instance.new("BlurEffect")
			blur.Name = "CAFSlowBlur"
			blur.Parent = Lighting
		end
		blur.Size = 3
	else
		local cc = Lighting:FindFirstChild("CAFSlowCC")
		if cc then cc:Destroy() end
		local blur = Lighting:FindFirstChild("CAFSlowBlur")
		if blur then blur:Destroy() end
	end
end

local function shakeCamera(magnitude)
	local cam = workspace.CurrentCamera
	if not cam then return end
	pcall(function()
		cam:Shake(Enum.CameraShakePresets.Bump, magnitude or 0.5)
	end)
end

local function saveCollision(part)
	if part:GetAttribute("CAFOrigCollide") == nil then
		part:SetAttribute("CAFOrigCollide", part.CanCollide)
	end
end

local function restoreCollision(char)
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then
			local v = p:GetAttribute("CAFOrigCollide")
			if v ~= nil then p.CanCollide = v end
		end
	end
end

-- cached character parts (perf: no GetDescendants every frame)
local cachedChar, cachedParts, cachedConn
local function getCharParts()
	local char = player.Character
	if not char then return nil end
	if cachedChar ~= char then
		if cachedConn then cachedConn:Disconnect() end
		cachedChar = char
		cachedParts = {}
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then table.insert(cachedParts, p) end
		end
		cachedConn = char.DescendantAdded:Connect(function(obj)
			if obj:IsA("BasePart") then table.insert(cachedParts, obj) end
		end)
	end
	return cachedParts
end

-- ================= FX KIT =================
local function effectsFolder()
	local f = workspace:FindFirstChild("CAFEffects")
	if not f then
		f = Instance.new("Folder")
		f.Name = "CAFEffects"
		f.Parent = workspace
	end
	return f
end

local function spawnParticles(parent, color, duration, rate, size)
	if not parent then return end
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = CONFIG.ParticleTexture
	pe.Rate = math.max(10, math.floor((rate or 100) * QUALITY))
	pe.Lifetime = NumberRange.new(0.35, 0.9)
	pe.Speed = NumberRange.new(3, 10)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Color = ColorSequence.new(color or Color3.fromRGB(180, 120, 255))
	pe.Size = NumberSequence.new(size or 0.35, 0)
	pe.Transparency = NumberSequence.new(0.2, 1)
	pe.LightEmission = 1
	pe.Parent = parent
	pe:Emit(math.floor(25 * QUALITY))
	task.delay(0.15, function()
		if pe and pe.Parent then pe.Rate = 0 end
	end)
	Debris:AddItem(pe, duration or 1.2)
end

local function spawnLight(parent, color, range, brightness, duration)
	if not parent then return end
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Parent = parent
	Debris:AddItem(light, duration or 1)
end

local function spawnTrail(root, color, duration)
	if not root then return end
	local a0 = Instance.new("Attachment")
	a0.Name = "CAFTrailA"
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = "CAFTrailB"
	a1.Position = Vector3.new(0, -1, 0)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.35
	trail.MinLength = 0.1
	trail.Color = ColorSequence.new(color)
	trail.LightEmission = 1
	trail.Parent = root
	Debris:AddItem(trail, duration or 0.6)
	Debris:AddItem(a0, (duration or 0.6) + 0.5)
	Debris:AddItem(a1, (duration or 0.6) + 0.5)
end

local function applyBodyVelocity(root, velocity, duration)
	if not root then return end
	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
	bv.Velocity = velocity
	bv.Parent = root
	Debris:AddItem(bv, duration or 0.25)
end

local function applyAngularVelocity(root, angular, duration)
	if not root then return end
	local attach = root:FindFirstChild("CAFAngularAttach")
	if not attach then
		attach = Instance.new("Attachment")
		attach.Name = "CAFAngularAttach"
		attach.Parent = root
	end
	local av = Instance.new("AngularVelocity")
	av.Attachment0 = attach
	av.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
	av.AngularVelocity = angular
	av.Parent = root
	Debris:AddItem(av, duration or 0.3)
end

local function shockwave(root, color, maxSize)
	if not root then return end
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.35
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Size = Vector3.new(1, 1, 1)
	part.CFrame = root.CFrame * CFrame.new(0, -2, 0)
	part.Parent = effectsFolder()
	TweenService:Create(part, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(maxSize, maxSize, maxSize),
		Transparency = 1,
	}):Play()
	Debris:AddItem(part, 0.9)
end

-- ================= RAGDOLL =================
local function applyRagdoll(enable)
	local char, hum, root = getCharacter()
	if not char or not hum or not root then return end
	if enable then
		if char:GetAttribute("CAFRagdolled") then return end
		char:SetAttribute("CAFRagdolled", true)
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then
				saveCollision(p)
				p.CanCollide = (p ~= root)
			end
		end
		local folder = Instance.new("Folder")
		folder.Name = "CAFRagdollFolder"
		folder.Parent = char
		for _, motor in ipairs(char:GetDescendants()) do
			if motor:IsA("Motor6D") and motor.Part0 and motor.Part1 then
				pcall(function()
					motor.Enabled = false
					local a0 = Instance.new("Attachment")
					a0.CFrame = motor.C0
					a0:SetAttribute("CAFRagdollAtt", true)
					a0.Parent = motor.Part0
					local a1 = Instance.new("Attachment")
					a1.CFrame = motor.C1
					a1:SetAttribute("CAFRagdollAtt", true)
					a1.Parent = motor.Part1
					local bs = Instance.new("BallSocketConstraint")
					bs.Attachment0 = a0
					bs.Attachment1 = a1
					bs.LimitsEnabled = false
					bs.Parent = folder
				end)
			end
		end
		hum.PlatformStand = true
		hum.AutoRotate = false
		hum.WalkSpeed = 0
		setJumpVelocity(hum, 0)
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
		root.AssemblyLinearVelocity = root.AssemblyLinearVelocity
			+ Vector3.new(math.random(-4, 4), 8, math.random(-4, 4))
		root.AssemblyAngularVelocity = root.AssemblyAngularVelocity
			+ Vector3.new(math.random(-3, 3), math.random(-3, 3), math.random(-3, 3))
	else
		if not char:GetAttribute("CAFRagdolled") then return end
		char:SetAttribute("CAFRagdolled", false)
		local rootMotor = nil
		for _, motor in ipairs(char:GetDescendants()) do
			if motor:IsA("Motor6D") and (motor.Name == "Root" or motor.Part0 == root) then
				rootMotor = motor
				break
			end
		end
		local torso = char:FindFirstChild("LowerTorso")
			or char:FindFirstChild("Torso")
			or char:FindFirstChild("UpperTorso")
		if rootMotor and torso then
			pcall(function()
				root.CFrame = torso.CFrame * rootMotor.C1 * rootMotor.C0:Inverse()
			end)
		end
		local folder = char:FindFirstChild("CAFRagdollFolder")
		if folder then folder:Destroy() end
		for _, motor in ipairs(char:GetDescendants()) do
			if motor:IsA("Motor6D") then motor.Enabled = true end
		end
		for _, obj in ipairs(char:GetDescendants()) do
			if obj:IsA("Attachment") and obj:GetAttribute("CAFRagdollAtt") then
				obj:Destroy()
			end
		end
		restoreCollision(char)
		hum.PlatformStand = false
		hum.AutoRotate = true
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
	end
end

-- ================= NOCLIP =================
local function applyNoClip(enable)
	local char, hum, root = getCharacter()
	if not char or not hum or not root then return end
	if enable then
		if char:GetAttribute("CAFNoClipped") then return end
		char:SetAttribute("CAFNoClipped", true)
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then
				saveCollision(p)
				p.CanCollide = false
			end
		end
		hum.PlatformStand = true
		hum.AutoRotate = false
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
	else
		if not char:GetAttribute("CAFNoClipped") then return end
		char:SetAttribute("CAFNoClipped", false)
		restoreCollision(char)
		hum.PlatformStand = false
		hum.AutoRotate = true
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
		root.AssemblyLinearVelocity = Vector3.zero
		noclipUp = false
		noclipDown = false
	end
end

-- ================= AURA LOOP / SHIELD =================
local function applyAuraLoop(on)
	local char, hum, root = getCharacter()
	if not root then return end
	local existing = root:FindFirstChild("CAFAuraLoopPE")
	if on then
		if existing then return end
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "CAFAuraLoopPE"
		pe.Texture = CONFIG.ParticleTexture
		pe.Rate = math.floor(40 * QUALITY)
		pe.Lifetime = NumberRange.new(0.6, 1.2)
		pe.Speed = NumberRange.new(2, 6)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Color = ColorSequence.new(
			Color3.fromRGB(190, 120, 255),
			Color3.fromRGB(255, 200, 80)
		)
		pe.Size = NumberSequence.new(0.5, 0)
		pe.Transparency = NumberSequence.new(0.1, 1)
		pe.LightEmission = 1
		pe.Parent = root
	else
		if existing then existing:Destroy() end
	end
end

local function applyShield(enable)
	local char, hum, root = getCharacter()
	if not char then return end
	if enable then
		local ff = char:FindFirstChild("CAFShield")
		if not ff then
			ff = Instance.new("ForceField")
			ff.Name = "CAFShield"
			ff.Parent = char
		end
		ff.Visible = true
		if root then
			spawnParticles(root, Color3.fromRGB(70, 190, 255), 1.2, 120, 0.45)
			spawnLight(root, Color3.fromRGB(70, 190, 255), 12, 2, 1.2)
		end
	else
		local ff = char:FindFirstChild("CAFShield")
		if ff then ff:Destroy() end
	end
end

-- ================= TOGGLE UPDATERS =================
local function updateToggle(name, on)
	local btn = toggles[name]
	if not btn then return end
	local base = btn:GetAttribute("BaseText") or btn.Text
	btn.Text = base .. (on and "  ON" or "  OFF")
	local stroke = btn:FindFirstChildOfClass("UIStroke")
	if on then
		btn.BackgroundColor3 = Color3.fromRGB(25, 110, 75)
		if stroke then stroke.Color = GREEN end
	else
		btn.BackgroundColor3 = BTN_BG
		if stroke then stroke.Color = BTN_STROKE end
	end
end

local function updateAllToggles()
	for name in pairs(toggles) do
		updateToggle(name, states[name] == true)
	end
end

-- ================= MOVES =================
local function doge(direction)
	local char, hum, root = getCharacter()
	if not root or states.Ragdoll then return end
	local now = os.clock()
	if now - dogeCD < 0.18 then return end
	dogeCD = now
	local dir
	if direction == "Left" then dir = -root.CFrame.RightVector
	elseif direction == "Right" then dir = root.CFrame.RightVector
	else dir = -root.CFrame.LookVector end
	dir = Vector3.new(dir.X, 0, dir.Z)
	if dir.Magnitude > 0.001 then dir = dir.Unit else dir = Vector3.new(0, 0, -1) end
	local spin
	if direction == "Left" then spin = Vector3.new(0, -28, 0)
	elseif direction == "Right" then spin = Vector3.new(0, 28, 0)
	else spin = root.CFrame.RightVector * -24 end
	if states.NoClip then
		root.CFrame = root.CFrame + dir * 18
	else
		local velocity = dir * 85
			+ Vector3.new(0, math.max(root.AssemblyLinearVelocity.Y, 0) + 12, 0)
		applyBodyVelocity(root, velocity, 0.24)
	end
	applyAngularVelocity(root, spin, 0.3)
	spawnTrail(root, Color3.fromRGB(120, 200, 255), 0.5)
	spawnParticles(root, Color3.fromRGB(120, 200, 255), 0.6, 80, 0.3)
	shakeCamera(0.35)
end

local function auraBurst()
	local char, hum, root = getCharacter()
	if not root or states.Ragdoll then return end
	states.Overdrive = true
	refreshMovement()
	spawnParticles(root, Color3.fromRGB(255, 200, 60), 3, 220, 0.55)
	spawnLight(root, Color3.fromRGB(255, 200, 60), 16, 3, 5)
	spawnTrail(root, Color3.fromRGB(255, 200, 60), 4)
	tweenFOV(currentFOV(), 0.25)
	shakeCamera(0.65)
	root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + Vector3.new(0, 35, 0)
	burstToken = burstToken + 1
	local my = burstToken
	task.delay(5, function()
		if burstToken == my then
			states.Overdrive = false
			refreshMovement()
			tweenFOV(currentFOV(), 0.4)
		end
	end)
end

local function phantomDash()
	local char, hum, root = getCharacter()
	if not root or states.Ragdoll then return end
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude > 0.001 then flat = flat.Unit else flat = Vector3.new(0, 0, -1) end
	if states.NoClip then
		root.CFrame = root.CFrame + flat * 30
	else
		local velocity = flat * 130
			+ Vector3.new(0, math.max(root.AssemblyLinearVelocity.Y, 0) + 10, 0)
		applyBodyVelocity(root, velocity, 0.2)
	end
	spawnTrail(root, Color3.fromRGB(170, 90, 255), 0.7)
	spawnParticles(root, Color3.fromRGB(170, 90, 255), 0.7, 140, 0.4)
	shakeCamera(0.45)
end

local function titanStomp()
	local char, hum, root = getCharacter()
	if not root or states.Ragdoll then return end
	if states.NoClip then
		shockwave(root, Color3.fromRGB(255, 120, 40), 26)
		shakeCamera(1)
		return
	end
	local grounded = hum.FloorMaterial ~= Enum.Material.Air
	if grounded then
		root.AssemblyLinearVelocity = Vector3.new(
			root.AssemblyLinearVelocity.X, -10, root.AssemblyLinearVelocity.Z)
		shockwave(root, Color3.fromRGB(255, 120, 40), 22)
		spawnParticles(root, Color3.fromRGB(255, 120, 40), 0.8, 180, 0.6)
		shakeCamera(1)
		task.delay(0.12, function()
			local _, _, r = getCharacter()
			if r then applyBodyVelocity(r, Vector3.new(0, 60, 0), 0.15) end
		end)
	else
		applyBodyVelocity(root, Vector3.new(
			root.AssemblyLinearVelocity.X, -180, root.AssemblyLinearVelocity.Z), 0.16)
		spawnTrail(root, Color3.fromRGB(255, 120, 40), 0.4)
		task.delay(0.25, function()
			local _, _, r = getCharacter()
			if r then
				shockwave(r, Color3.fromRGB(255, 120, 40), 30)
				shakeCamera(1.2)
			end
		end)
	end
end

local function meteorDive()
	local char, hum, root = getCharacter()
	if not root or states.Ragdoll then return end
	if states.NoClip then
		shockwave(root, Color3.fromRGB(255, 90, 30), 24)
		shakeCamera(0.9)
		return
	end
	local function dive()
		local _, _, r = getCharacter()
		if not r then return end
		applyBodyVelocity(r, Vector3.new(
			r.AssemblyLinearVelocity.X * 0.2, -240, r.AssemblyLinearVelocity.Z * 0.2), 0.3)
		spawnTrail(r, Color3.fromRGB(255, 90, 30), 0.5)
		task.delay(0.45, function()
			local _, _, r2 = getCharacter()
			if not r2 then return end
			shockwave(r2, Color3.fromRGB(255, 90, 30), 34)
			spawnParticles(r2, Color3.fromRGB(255, 140, 40), 0.7, 200, 0.7)
			shakeCamera(1.3)
		end)
	end
	local grounded = hum.FloorMaterial ~= Enum.Material.Air
	if grounded then
		applyBodyVelocity(root, Vector3.new(0, 95, 0), 0.16)
		task.delay(0.24, dive)
	else
		dive()
	end
end

local function auraFlare()
	local char, hum, root = getCharacter()
	if not root or states.Ragdoll then return end
	applyAngularVelocity(root, Vector3.new(0, 45, 0), 0.45)
	shockwave(root, Color3.fromRGB(255, 255, 255), 18)
	spawnParticles(root, Color3.fromRGB(255, 255, 255), 0.7, 250, 0.45)
	spawnLight(root, Color3.fromRGB(255, 255, 255), 18, 4, 0.6)
	shakeCamera(0.8)
	tweenFOV(90, 0.1)
	task.delay(0.3, function() tweenFOV(currentFOV(), 0.35) end)
	flareUntil = os.clock() + 1.5
	refreshMovement()
end

local function timeSkip()
	local char, hum, root = getCharacter()
	if not root or states.Ragdoll or states.TimeSkip then return end
	states.TimeSkip = true
	refreshMovement()
	setSlowVisual(true)
	tweenFOV(currentFOV(), 0.2)
	spawnParticles(root, Color3.fromRGB(255, 255, 255), 0.8, 160, 0.35)
	shakeCamera(0.4)
	tsToken = tsToken + 1
	local my = tsToken
	task.delay(1.4, function()
		if tsToken == my then
			states.TimeSkip = false
			if not states.SlowMo then setSlowVisual(false) end
			refreshMovement()
			tweenFOV(currentFOV(), 0.3)
		end
	end)
end

local function domainExpand()
	local char, hum, root = getCharacter()
	if not root or states.Ragdoll then return end
	states.Domain = true
	refreshMovement()
