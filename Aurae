	grad.Rotation = 90
	grad.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(0.68, 0.68, 0.78))
	btn.MouseEnter:Connect(function()
		stroke.Color = ACCENT
	end)
	btn.MouseLeave:Connect(function()
		local on = toggles[btn.Name] and states[btn.Name]
		stroke.Color = on and GREEN or BTN_STROKE
	end)
end

local function createButton(text, color)
	local btn = Instance.new("TextButton")
	btn.BackgroundColor3 = color or BTN_BG
	btn.TextColor3 = Color3.fromRGB(245, 245, 255)
	btn.Font = FONT_BOLD
	btn.TextSize = 15
	btn.TextWrapped = true
	btn.BorderSizePixel = 0
	btn.Size = UDim2.new(1, -2, 0, 42)
	btn.AutoButtonColor = true
	btn.Visible = true
	btn.LayoutOrder = nextOrder()
	btn.Parent = scroll
	btn.Text = text
	styleButton(btn)
	return btn
end

local function makeToggle(name, text, callback)
	local btn = createButton(text)
	btn.Name = name
	btn:SetAttribute("BaseText", text)
	toggles[name] = btn
	updateToggle(name, false)
	btn.MouseButton1Click:Connect(function()
		if typeof(callback) == "function" then callback() end
	end)
	return btn
end

local function makeAction(text, color, callback)
	local btn = createButton(text, color)
	btn.MouseButton1Click:Connect(function()
		if typeof(callback) == "function" then callback() end
		local old = btn.BackgroundColor3
		btn.BackgroundColor3 = Color3.fromRGB(110, 115, 150)
		task.delay(0.12, function()
			if btn and btn.Parent then btn.BackgroundColor3 = old end
		end)
	end)
	return btn
end

local function makeActionCD(text, color, seconds, callback)
	local btn = createButton(text, color)
	local entry = {btn = btn, base = text, untilVal = 0}
	table.insert(cdEntries, entry)
	btn.MouseButton1Click:Connect(function()
		local now = os.clock()
		if now < entry.untilVal then
			toast("COOLDOWN: " .. string.format("%.1f", entry.untilVal - now) .. "s",
				Color3.fromRGB(255, 130, 130))
			return
		end
		if typeof(callback) == "function" then callback() end
		if seconds > 0 then entry.untilVal = now + seconds end
		local old = btn.BackgroundColor3
		btn.BackgroundColor3 = Color3.fromRGB(110, 115, 150)
		task.delay(0.12, function()
			if btn and btn.Parent then btn.BackgroundColor3 = old end
		end)
	end)
	return btn
end

local function makeHold(text, color, setFn)
	local btn = createButton(text, color)
	local function press()
		if not states.NoClip then
			local now = os.clock()
			if now - lastHint > 2 then
				lastHint = now
				toast("Turn ON Wall Phase / NoClip first", Color3.fromRGB(255, 200, 120))
			end
			return
		end
		if typeof(setFn) == "function" then setFn(true) end
		btn.BackgroundColor3 = Color3.fromRGB(110, 115, 150)
	end
	local function release()
		if typeof(setFn) == "function" then setFn(false) end
		btn.BackgroundColor3 = color or BTN_BG
	end
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1 then
			press()
		end
	end)
	btn.InputEnded:Connect(function() release() end)
	btn.MouseLeave:Connect(release)
	return btn
end

