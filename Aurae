		local prevStacks = math.floor(auraStacks)
		if states.AuraLoop then
			auraStacks = math.min(auraStacks + CONFIG.StackRate * 0.3, CONFIG.MaxStacks)
		end
		if math.floor(auraStacks) ~= prevStacks then refreshMovement() end
		-- flare expire
		local fa = os.clock() < flareUntil
		if fa ~= flareActive then
			flareActive = fa
			refreshMovement()
		end
	end

	-- cooldown timers on buttons
	local now = os.clock()
	for _, e in ipairs(cdEntries) do
		local rem = e.untilVal - now
		if rem > 0 then
			e.btn.Text = e.base .. "  [" .. string.format("%.1f", rem) .. "s]"
			e.btn.TextColor3 = Color3.fromRGB(150, 150, 160)
		elseif e.btn.Text ~= e.base then
			e.btn.Text = e.base
			e.btn.TextColor3 = Color3.fromRGB(245, 245, 255)
		end
	end

	local char, hum, root = getCharacter()
	if not char or not hum or not root then return end

	-- shield regen (real effect)
	if states.Shield then
		hum.Health = math.min(hum.Health + CONFIG.RegenPerSec * dt, hum.MaxHealth)
	end

	-- cinematic floaty fall (real effect)
	if states.Cinematic and not states.NoClip and not states.Ragdoll then
		local v = root.AssemblyLinearVelocity
		if v.Y < -45 then
			root.AssemblyLinearVelocity = Vector3.new(v.X, -45, v.Z)
		end
	end

	-- slow-mo / time-skip velocity clamp
	local clampMax = nil
	if states.TimeSkip then clampMax = 4
	elseif states.SlowMo and not states.Overdrive then clampMax = 9 end
	if clampMax then
		local parts = getCharParts()
		if parts then
			for _, p in ipairs(parts) do
				if p.Parent then
					local v = p.AssemblyLinearVelocity
					if v.Magnitude > clampMax then
						p.AssemblyLinearVelocity = v.Unit * clampMax
					end
					local av = p.AssemblyAngularVelocity
					local avMax = clampMax * 0.5
					if av.Magnitude > avMax then
						p.AssemblyAngularVelocity = av.Unit * avMax
					end
				end
			end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if not states.NoClip then return end
	local char, hum, root = getCharacter()
	if not hum or not root then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	local move = hum.MoveDirection
	local camCF = cam.CFrame
	local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
	if flatLook.Magnitude > 0.001 then flatLook = flatLook.Unit else flatLook = Vector3.new(0, 0, -1) end
	local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
	if flatRight.Magnitude > 0.001 then flatRight = flatRight.Unit else flatRight = Vector3.new(1, 0, 0) end
	local f = move:Dot(flatLook)
	local r = move:Dot(flatRight)
	local vertical = 0
	if noclipUp then vertical = vertical + 1 end
	if noclipDown then vertical = vertical - 1 end
	local input = Vector3.new(r, vertical, f)
	if input.Magnitude > 1 then input = input.Unit end
	local world = camCF:VectorToWorldSpace(input)
	local speed = CONFIG.NoClipSpeed
	if states.SlowMo then speed = 16 end
	if states.Overdrive then speed = 90 end
	if states.Domain then speed = speed * 1.3 end
	root.AssemblyLinearVelocity = world * speed
	local flatWorld = Vector3.new(world.X, 0, world.Z)
	if flatWorld.Magnitude > 0.1 then
		local target = CFrame.lookAt(root.Position, root.Position + flatWorld.Unit)
		root.CFrame = root.CFrame:Lerp(target, 0.25)
	end
end)

