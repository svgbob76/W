local HunterManager = {}

function HunterManager:CreateHunterModel(hunterConfig)
    local model = Instance.new("Model")
    model.Name = "Hunter_" .. hunterConfig.Name

    -- Create parts
    local parts = {
        {Name = "HumanoidRootPart", Size = Vector3.new(2, 2, 1), CanCollide = false},
        {Name = "Torso", Size = Vector3.new(2, 2, 1)},
        {Name = "Head", Size = Vector3.new(2, 1, 1)},
        {Name = "Left Arm", Size = Vector3.new(1, 2, 1)},
        {Name = "Right Arm", Size = Vector3.new(1, 2, 1)},
        {Name = "Left Leg", Size = Vector3.new(1, 2, 1)},
        {Name = "Right Leg", Size = Vector3.new(1, 2, 1)},
    }

    local colorMap = {
        Head = hunterConfig.BodyColors.Head,
        Torso = hunterConfig.BodyColors.Torso,
        ["Left Arm"] = hunterConfig.BodyColors.Arms,
        ["Right Arm"] = hunterConfig.BodyColors.Arms,
        ["Left Leg"] = hunterConfig.BodyColors.Legs,
        ["Right Leg"] = hunterConfig.BodyColors.Legs,
    }

    local createdParts = {}

    for _, partData in ipairs(parts) do
        local part = Instance.new("Part")
        part.Name = partData.Name
        part.Size = partData.Size
        part.BrickColor = BrickColor.new(colorMap[partData.Name] or hunterConfig.BodyColors.Torso)
        part.Color = colorMap[partData.Name] or hunterConfig.BodyColors.Torso
        part.Material = Enum.Material.SmoothPlastic
        part.CastShadow = true

        if partData.CanCollide == false then
            part.CanCollide = false
        end

        -- Add glow effect to make hunters look scary
        if partData.Name == "Head" or partData.Name == "Torso" then
            local selectionBox = Instance.new("SelectionBox")
            selectionBox.Adornee = part
            selectionBox.Color3 = hunterConfig.SecondaryColor
            selectionBox.LineThickness = 0.05
            selectionBox.SurfaceTransparency = 1
            selectionBox.Parent = part
        end

        part.Parent = model
        createdParts[partData.Name] = part
    end

    -- Weld everything together
    local function Weld(a, b, c0, c1)
        local weld = Instance.new("Motor6D")
        weld.Part0 = a
        weld.Part1 = b
        weld.C0 = c0 or CFrame.new()
        weld.C1 = c1 or CFrame.new()
        weld.Parent = a
        return weld
    end

    local root = createdParts["HumanoidRootPart"]
    local torso = createdParts["Torso"]
    local head = createdParts["Head"]
    local lArm = createdParts["Left Arm"]
    local rArm = createdParts["Right Arm"]
    local lLeg = createdParts["Left Leg"]
    local rLeg = createdParts["Right Leg"]

    model.PrimaryPart = root

    Weld(root, torso, CFrame.new(), CFrame.new())
    Weld(torso, head, CFrame.new(0, 1, 0), CFrame.new(0, -0.5, 0))
    Weld(torso, lArm, CFrame.new(-1.5, 0, 0), CFrame.new(0.5, 0, 0))
    Weld(torso, rArm, CFrame.new(1.5, 0, 0), CFrame.new(-0.5, 0, 0))
    Weld(torso, lLeg, CFrame.new(-0.5, -2, 0), CFrame.new(0, 1, 0))
    Weld(torso, rLeg, CFrame.new(0.5, -2, 0), CFrame.new(0, 1, 0))

    -- Add humanoid
    local humanoid = Instance.new("Humanoid")
    humanoid.MaxHealth = hunterConfig.Health
    humanoid.Health = hunterConfig.Health
    humanoid.WalkSpeed = hunterConfig.Speed
    humanoid.JumpPower = 50
    humanoid.DisplayName = hunterConfig.DisplayName
    humanoid.NameDisplayDistance = 50
    humanoid.Parent = model

    -- Humanoid description for display
    local humanoidDesc = Instance.new("HumanoidDescription")
    humanoidDesc.Parent = humanoid

    -- Name tag with glow
    local billboardGui = Instance.new("BillboardGui")
    billboardGui.Size = UDim2.new(0, 200, 0, 50)
    billboardGui.StudsOffset = Vector3.new(0, 3.5, 0)
    billboardGui.AlwaysOnTop = false
    billboardGui.Parent = createdParts["Head"]

    local nameLabel2 = Instance.new("TextLabel")
    nameLabel2.Size = UDim2.new(1, 0, 1, 0)
    nameLabel2.BackgroundTransparency = 1
    nameLabel2.TextColor3 = hunterConfig.SecondaryColor
    nameLabel2.TextScaled = true
    nameLabel2.Font = Enum.Font.GothamBold
    nameLabel2.Text = "☠ " .. hunterConfig.DisplayName
    nameLabel2.TextStrokeTransparency = 0
    nameLabel2.TextStrokeColor3 = hunterConfig.Color
    nameLabel2.Parent = billboardGui

    -- Add special eye glow effect
    local eyePart = Instance.new("Part")
    eyePart.Name = "EyeGlow"
    eyePart.Size = Vector3.new(1.8, 0.4, 0.1)
    eyePart.Material = Enum.Material.Neon
    eyePart.Color = hunterConfig.SecondaryColor
    eyePart.CanCollide = false
    eyePart.CastShadow = false
    eyePart.Parent = model

    local eyeWeld = Instance.new("WeldConstraint")
    eyeWeld.Part0 = head
    eyeWeld.Part1 = eyePart
    eyeWeld.Parent = eyePart

    eyePart.CFrame = head.CFrame * CFrame.new(0, 0.1, -0.55)

    -- Place model in workspace
    local spawnPos = self:GetHunterSpawnPosition()
    model:SetPrimaryPartCFrame(CFrame.new(spawnPos))
    model.Parent = Workspace

    -- Add hat/accessory for personality
    self:AddHunterAccessory(model, hunterConfig, createdParts["Head"])

    return model, humanoid
end

function HunterManager:AddHunterAccessory(model, config, headPart)
    -- Each hunter gets a unique visual accessory
    local accessories = {
        SHADOW = function()
            -- Dark hood
            local hood = Instance.new("Part")
            hood.Size = Vector3.new(2.2, 1.2, 2.2)
            hood.BrickColor = BrickColor.new(config.BodyColors.Head)
            hood.Material = Enum.Material.Fabric
            hood.CanCollide = false
            hood.Parent = model

            local hoodWeld = Instance.new("WeldConstraint")
            hoodWeld.Part0 = headPart
            hoodWeld.Part1 = hood
            hoodWeld.Parent = hood
            hood.CFrame = headPart.CFrame * CFrame.new(0, 0.3, 0)

            local hoodCorner = Instance.new("SpecialMesh")
            hoodCorner.MeshType = Enum.MeshType.Sphere
            hoodCorner.Scale = Vector3.new(1.15, 1.25, 1.15)
            hoodCorner.Parent = hood
        end,
        PHANTOM = function()
            -- Spectral crown
            for i = 1, 5 do
                local spike = Instance.new("Part")
                spike.Size = Vector3.new(0.2, 0.6, 0.2)
                spike.Material = Enum.Material.Neon
                spike.Color = config.SecondaryColor
                spike.CanCollide = false
                spike.Parent = model

                local spikeWeld = Instance.new("WeldConstraint")
                spikeWeld.Part0 = headPart
                spikeWeld.Part1 = spike
                spikeWeld.Parent = spike

                local angle = (i / 5) * math.pi * 2
                spike.CFrame = headPart.CFrame * CFrame.new(
                    math.cos(angle) * 0.8,
                    0.8,
                    math.sin(angle) * 0.8
                ) * CFrame.Angles(0, angle, math.rad(20))
            end
        end,
        WRAITH = function()
            -- Horns
            for side = -1, 1, 2 do
                local horn = Instance.new("Part")
                horn.Size = Vector3.new(0.3, 0.8, 0.3)
                horn.Material = Enum.Material.SmoothPlastic
                horn.Color = Color3.fromRGB(30, 0, 0)
                horn.CanCollide = false
                horn.Parent = model

                local hornMesh = Instance.new("SpecialMesh")
                hornMesh.MeshType = Enum.MeshType.Cylinder
                hornMesh.Parent = horn

                local hornWeld = Instance.new("WeldConstraint")
                hornWeld.Part0 = headPart
                hornWeld.Part1 = horn
                hornWeld.Parent = horn

                horn.CFrame = headPart.CFrame * CFrame.new(side * 0.6, 0.7, 0) * CFrame.Angles(0, 0, math.rad(side * 25))
            end
        end,
    }

    if accessories[config.Name] then
        accessories[config.Name]()
    end
end

function HunterManager:GetHunterSpawnPosition()
    -- Spawn hunters away from the player
    local char = LocalPlayer.Character
    local playerPos = char and char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Position or Vector3.new(0, 10, 0)

    local angle = math.random() * math.pi * 2
    local distance = math.random(100, 200)

    local pos = playerPos + Vector3.new(
        math.cos(angle) * distance,
        0,
        math.sin(angle) * distance
    )

    -- Find ground
    local ray = Workspace:Raycast(pos + Vector3.new(0, 50, 0), Vector3.new(0, -100, 0))
    if ray then
        return ray.Position + Vector3.new(0, 5, 0)
    end

    return Vector3.new(pos.X, 10, pos.Z)
end

function HunterManager:CreateHunterTools(hunter, model)
    for _, toolName in ipairs(hunter.Config.Tools) do
        local tool = Instance.new("Tool")
        tool.Name = toolName
        tool.RequiresHandle = true

        local handle = Instance.new("Part")
