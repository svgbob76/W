-- MAIN GAME LOOP
-- ============================================================

local MainLoop = {}

function MainLoop:UpdateHUD()
    if GameState.Phase == "COUNTDOWN" then
        local elapsed = tick() - GameState.HuntStartTime
        local remaining = CONFIG.HUNT_START_DELAY - elapsed

        if remaining <= 0 then
            -- Start hunting!
            GameState.Phase = "HUNTING"
            GameState.UIElements.CountdownFrame.Visible = false

            -- Flash the hunting alert
            local alert = GameState.UIElements.HuntingAlert
            alert.Visible = true
            alert.BackgroundTransparency = 0.3

            task.spawn(function()
                for i = 1, 6 do
                    local t = CreateTween(alert, {BackgroundTransparency = 0.1}, 0.2)
                    t:Play()
                    task.wait(0.25)
                    local t2 = CreateTween(alert, {BackgroundTransparency = 0.6}, 0.2)
                    t2:Play()
                    task.wait(0.25)
                end
                task.wait(0.5)
                local hide = CreateTween(alert, {BackgroundTransparency = 1}, 0.5)
                hide:Play()
                task.wait(0.5)
                alert.Visible = false
            end)

            -- Release hunters
            for _, hunter in ipairs(GameState.Hunters) do
                local humanoid = hunter.Model and hunter.Model:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid.WalkSpeed = hunter.Config.Speed
                end
            end
        else
            -- Update countdown
            local label = GameState.UIElements.CountdownLabel
            if label then
                label.Text = "HEAD START: " .. math.ceil(remaining) .. "s"

                -- Color shifts as time runs out
                if remaining < 10 then
                    label.TextColor3 = Color3.fromRGB(255, 50, 50)
                elseif remaining < 20 then
                    label.TextColor3 = Color3.fromRGB(255, 150, 50)
                else
                    label.TextColor3 = Color3.fromRGB(255, 200, 0)
                end
            end
        end
    end

    if GameState.Phase == "HUNTING" then
        -- Update survival timer
        local elapsed = tick() - GameState.HuntStartTime - CONFIG.HUNT_START_DELAY
        if elapsed > 0 then
            local minutes = math.floor(elapsed / 60)
            local seconds = math.floor(elapsed % 60)
            local timerLabel = GameState.UIElements.TimerLabel
            if timerLabel then
                timerLabel.Text = string.format("%02d:%02d", minutes, seconds)
            end

            GameState.PlayerData.TimeAlive = elapsed
        end
    end
end

function MainLoop:UpdateCompassAndDanger()
    if GameState.Phase ~= "HUNTING" and GameState.Phase ~= "COUNTDOWN" then return end

    CompassSystem:Update()

    local nearestDist = DangerSystem:GetNearestHunterDistance()
    DangerSystem:UpdateDangerLevel(nearestDist)
end

function MainLoop:TrackPlayerData()
    local char = LocalPlayer.Character
    if not char then return end

    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local pos = rootPart.Position
    local data = GameState.PlayerData

    -- Track position history
    table.insert(data.LastPositions, pos)
    if #data.LastPositions > 50 then
        table.remove(data.LastPositions, 1)
    end

    data.Position = pos
end

function MainLoop:UpdateHunterAI(dt)
    if GameState.Phase ~= "HUNTING" and GameState.Phase ~= "COUNTDOWN" then return end

    for _, hunter in ipairs(GameState.Hunters) do
        task.spawn(function()
            HunterBehavior:UpdateHunter(hunter, dt)
        end)
    end
end

