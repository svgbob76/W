        -- Glow effect
        local pointLight = Instance.new("PointLight")
        pointLight.Color = hunter.Config.SecondaryColor
        pointLight.Range = 8
        pointLight.Brightness = 2
        pointLight.Parent = handle

        tool.Parent = model

        -- Equip first tool
        if toolName == hunter.Config.Tools[1] then
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            if humanoid then
                task.spawn(function()
                    task.wait(0.5)
                    humanoid:EquipTool(tool)
                end)
            end
        end
    end
end

