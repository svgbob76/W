local TextAnimator = {}

function TextAnimator:TypeWrite(label, text, speed, color)
    label.Text = ""
    local displayed = ""
    speed = speed or 0.05
    color = color or label.TextColor3

    for i = 1, #text do
        local char = text:sub(i, i)
        displayed = displayed .. char
        label.Text = displayed
        label.TextColor3 = color
        if char ~= " " and char ~= "\n" then
            task.wait(speed)
        end
    end
end

function TextAnimator:GlitchReveal(label, finalText, duration)
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*"
    local steps = math.floor(duration / 0.05)

    for step = 1, steps do
        local revealed = math.floor((step / steps) * #finalText)
        local glitched = ""

        for i = 1, #finalText do
            if i <= revealed then
                glitched = glitched .. finalText:sub(i, i)
            else
                glitched = glitched .. chars:sub(math.random(1, #chars), math.random(1, #chars))
            end
        end

        label.Text = glitched
        task.wait(0.05)
    end

    label.Text = finalText
end

function TextAnimator:FlashText(label, text, times, interval, color1, color2)
    for i = 1, times do
        label.Text = text
        label.TextColor3 = color1 or Color3.fromRGB(255, 50, 50)
        task.wait(interval)
        label.TextColor3 = color2 or Color3.fromRGB(255, 200, 200)
        task.wait(interval)
    end
    label.TextColor3 = color1 or Color3.fromRGB(255, 50, 50)
end

