local function Initialize()
    print("[MANHUNT] Initializing...")

    -- Wait for character
    local char = WaitForCharacter()
    task.wait(1)

    -- Initialize UI
    UIManager:Init()

    -- Create hunters
    print("[MANHUNT] Creating hunters...")
    for i, hunterConfig in ipairs(CONFIG.HUNTERS) do
        local model, humanoid = HunterManager:CreateHunterModel(hunterConfig)
        HunterManager:CreateHunterTools({Config = hunterConfig, Model = model}, model)

        -- Initially freeze hunters
        if humanoid then
            humanoid.WalkSpeed = 0
        end

        local ai = HunterAI:New(hunterConfig, model)

        table.insert(GameState.Hunters, {
            Config = hunterConfig,
            Model = model,
            Humanoid = humanoid,
            AI = ai,
        })

        print("[MANHUNT] Created hunter: " .. hunterConfig.Name)
    end

    -- Start intro
    task.wait(0.5)
    print("[MANHUNT] Playing intro...")
    task.spawn(function()
        IntroSystem:PlayIntro()
    end)

    -- Main game loop
    local aiTimer = 0
    local compassTimer = 0

    RunService.Heartbeat:Connect(function(dt)
        aiTimer = aiTimer + dt
        compassTimer = compassTimer + dt

        -- Update HUD every frame
        MainLoop:UpdateHUD()

        -- Update compass frequently
        if compassTimer >= CONFIG.COMPASS_UPDATE_RATE then
            compassTimer = 0
            MainLoop:UpdateCompassAndDanger()
        end

        -- Update AI at set interval
        if aiTimer >= CONFIG.AI_UPDATE_RATE then
            aiTimer = 0
            MainLoop:TrackPlayerData()
            MainLoop:UpdateHunterAI(CONFIG.AI_UPDATE_RATE)
        end
    end)

    -- Player death detection
    LocalPlayer.CharacterAdded:Connect(function(newChar)
        task.wait(1)
        char = newChar
        if GameState.Phase == "HUNTING" then
            -- Show death screen
            local deathScreen = Instance.new("Frame")
            deathScreen.Size = UDim2.new(1, 0, 1, 0)
            deathScreen.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
            deathScreen.BackgroundTransparency = 0
            deathScreen.ZIndex = 200
            deathScreen.Parent = GameState.UIElements.ScreenGui

            local deathLabel = Instance.new("TextLabel")
            deathLabel.Size = UDim2.new(1, 0, 0.2, 0)
            deathLabel.Position = UDim2.new(0, 0, 0.35, 0)
            deathLabel.BackgroundTransparency = 1
            deathLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            deathLabel.TextScaled = true
            deathLabel.Font = Enum.Font.GothamBold
            deathLabel.Text = "☠ CAUGHT ☠"
            deathLabel.ZIndex = 201
            deathLabel.Parent = deathScreen

            local timeLabel = Instance.new("TextLabel")
            timeLabel.Size = UDim2.new(1, 0, 0.1, 0)
            timeLabel.Position = UDim2.new(0, 0, 0.56, 0)
            timeLabel.BackgroundTransparency = 1
            timeLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
            timeLabel.TextScaled = true
            timeLabel.Font = Enum.Font.Gotham

            local survived = GameState.PlayerData.TimeAlive
            local min = math.floor(survived / 60)
            local sec = math.floor(survived % 60)
            timeLabel.Text = string.format("You survived for %02d:%02d", min, sec)
            timeLabel.ZIndex = 201
            timeLabel.Parent = deathScreen

            task.wait(4)

            local fade = CreateTween(deathScreen, {BackgroundTransparency = 1}, 1)
            fade:Play()
            task.wait(1)
            deathScreen:Destroy()

            GameState.Phase = "HUNTING"
        end
    end)

    print("[MANHUNT] Initialized successfully!")
end

