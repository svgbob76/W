local CameraController = {}
CameraController.OriginalCFrame = CFrame.new()
CameraController.OriginalType = Enum.CameraType.Custom

function CameraController:SaveState()
    self.OriginalCFrame = Camera.CFrame
    self.OriginalType = Camera.CameraType
end

function CameraController:SetCinematic()
    Camera.CameraType = Enum.CameraType.Scriptable
end

function CameraController:Restore()
    Camera.CameraType = self.OriginalType
end

function CameraController:MoveTo(targetCFrame, duration, style)
    local tween = CreateTween(Camera, {CFrame = targetCFrame}, duration, style or Enum.EasingStyle.Sine)
    tween:Play()
    task.wait(duration)
end

function CameraController:Shake(intensity, duration)
    local elapsed = 0
    while elapsed < duration do
        local dt = task.wait()
        elapsed = elapsed + dt
        local falloff = 1 - (elapsed / duration)
        local offset = Vector3.new(
            (math.random() - 0.5) * intensity * falloff,
            (math.random() - 0.5) * intensity * falloff,
            (math.random() - 0.5) * intensity * falloff
        )
        Camera.CFrame = Camera.CFrame * CFrame.new(offset)
    end
end

function CameraController:SweepToHunter(hunterModel, duration)
    if not hunterModel then return end

    local rootPart = hunterModel:FindFirstChild("HumanoidRootPart") or hunterModel.PrimaryPart
    if not rootPart then return end

    -- Start position: dramatic low angle
    local startPos = rootPart.Position + Vector3.new(15, 3, 15)
    local endPos = rootPart.Position + Vector3.new(5, 8, 5)

    Camera.CFrame = CFrame.new(startPos, rootPart.Position)

    -- Smooth sweep
    local steps = duration / 0.016
    for i = 1, steps do
        local t = i / steps
        local eased = 1 - (1 - t) ^ 3 -- Ease out cubic
        local pos = startPos:Lerp(endPos, eased)
        Camera.CFrame = CFrame.new(pos, rootPart.Position)
        task.wait(0.016)
    end
end

