local DangerSystem = {}

function DangerSystem:GetNearestHunterDistance()
    local char = LocalPlayer.Character
    if not char then return math.huge end

    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return math.huge end

    local nearest = math.huge
    for _, hunter in ipairs(GameState.Hunters) do
        if hunter.Model then
            local hRoot = hunter.Model:FindFirstChild("HumanoidRootPart") or hunter.Model.PrimaryPart
            if hRoot then
                local dist = (rootPart.Position - hRoot.Position).Magnitude
                if dist < nearest then
                    nearest = dist
                end
            end
        end
    end

    return nearest
end

function DangerSystem:UpdateDangerLevel(distance)
    local elements = GameState.UIElements

    -- Vignette intensity based on distance
    local maxDist = 100
    local dangerLevel = math.clamp(1 - (distance / maxDist), 0, 1)

    -- Update vignette
    local vigTransparency = 1 - (dangerLevel * 0.7)
    elements.Vignette.ImageTransparency = vigTransparency

    -- Heartbeat effect when very close
    if distance < 30 and GameState.Phase == "HUNTING" then
        self:TriggerHeartbeat(dangerLevel)
    end

    -- Status panel color based on danger
    if elements.StatusPanel then
        local dangerColor = LerpColor(
            Color3.fromRGB(50, 50, 50),
            Color3.fromRGB(200, 0, 0),
            dangerLevel
        )
        -- Animate border
        local border = elements.StatusPanel:FindFirstChildOfClass("UIStroke")
        if border then
            border.Color = dangerColor
        end
    end
end

local lastHeartbeat = 0
function DangerSystem:TriggerHeartbeat(intensity)
    if tick() - lastHeartbeat < (1.5 - intensity) then return end
    lastHeartbeat = tick()

    local frame = GameState.UIElements.HeartbeatFrame
    if not frame then return end

    frame.Visible = true
    frame.BackgroundTransparency = 0.8

    task.spawn(function()
        -- Quick pulse
        local p1 = CreateTween(frame, {BackgroundTransparency = 0.6}, 0.1)
        p1:Play()
        task.wait(0.1)
        local p2 = CreateTween(frame, {BackgroundTransparency = 0.85}, 0.15)
        p2:Play()
        task.wait(0.15)
        local p3 = CreateTween(frame, {BackgroundTransparency = 0.7}, 0.1)
        p3:Play()
        task.wait(0.1)
        local p4 = CreateTween(frame, {BackgroundTransparency = 1}, 0.4)
        p4:Play()
        task.wait(0.4)
        frame.Visible = false
    end)
end

-- ============================================================
-- COMPASS SYSTEM
-- ============================================================

local CompassSystem = {}

function CompassSystem:Update()
    local char = LocalPlayer.Character
    if not char then return end

    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    -- Find nearest hunter
    local nearestHunter = nil
    local nearestDist = math.huge

    for _, hunter in ipairs(GameState.Hunters) do
        if hunter.Model then
            local hRoot = hunter.Model:FindFirstChild("HumanoidRootPart") or hunter.Model.PrimaryPart
            if hRoot then
                local dist = (rootPart.Position - hRoot.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                end
                nearestHunter = hRoot
            end
        end
    end

    if not nearestHunter then return end

    -- Calculate compass angle
    local toHunter = (nearestHunter.Position - rootPart.Position)
    local hunterAngle = math.atan2(toHunter.X, toHunter.Z)
    local playerAngle = rootPart.CFrame.LookVector
    local camAngle = math.atan2(playerAngle.X, playerAngle.Z)
    local relativeAngle = hunterAngle - camAngle

    -- Smooth rotation of compass needle
    GameState.CompassAngle = relativeAngle

    local needle = GameState.UIElements.CompassNeedle
    if needle then
        local compassFrame = GameState.UIElements.CompassFrame
        local centerX = compassFrame.AbsoluteSize.X / 2
        local centerY = compassFrame.AbsoluteSize.Y / 2
        local radius = compassFrame.AbsoluteSize.X * 0.35

        local needleX = 0.5 + (math.sin(relativeAngle) * 0.35) - (needle.Size.X.Scale / 2)
        local needleY = 0.5 - (math.cos(relativeAngle) * 0.35) - (needle.Size.Y.Scale / 2)

        -- Rotate needle (approximated with position)
        needle.Position = UDim2.new(needleX, 0, needleY, 0)
        needle.Rotation = math.deg(relativeAngle)
    end

    -- Update distance label
    local distLabel = GameState.UIElements.DistLabel
    if distLabel then
        local distText = ""
        if nearestDist < 50 then
            distText = "⚠ VERY CLOSE ⚠"
            distLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        elseif nearestDist < 100 then
            distText = math.floor(nearestDist) .. " studs"
            distLabel.TextColor3 = Color3.fromRGB(255, 150, 0)
        else
            distText = math.floor(nearestDist) .. " studs"
            distLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        distLabel.Text = distText
    end

    -- Ping sound when hunter gets close
    if nearestDist < 50 and GameState.Phase == "HUNTING" then
        -- Ping faster as hunter gets closer
        local pingInterval = math.clamp(nearestDist / 50, 0.1, 1)
        -- (Handled by timer in main loop)
    end
end

