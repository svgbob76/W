local HunterAI = {}

function HunterAI:New(hunterConfig, model)
    local ai = {
        Config = hunterConfig,
        Model = model,
        State = "PATROL",
        -- AI States: PATROL, CHASE, SEARCH, FLANK, ABILITY, INVESTIGATE
        LastKnownPlayerPos = nil,
        SearchPositions = {},
        LearnedData = {
            PlayerSpeed = 16,
            PlayerFavoriteAreas = {},
            PlayerEscapeDirection = Vector3.new(0,0,0),
            PlayerCombatStyle = "runner",
            TimesBehindPlayer = 0,
            PlayerHidingSpots = {},
            SuccessfulFlankPositions = {},
            PlayerItemUsage = {},
            LastCaughtAttempt = 0,
        },
        AbilityCooldown = 0,
        TargetPath = nil,
        CurrentWaypoint = 1,
        Alertness = 0,
        Memory = {}, -- Remember locations, items, events
        IsRaging = false, -- For WRAITH
        IsPhasing = false, -- For PHANTOM
        IsShadowing = false, -- For SHADOW
        AdaptationScore = 0,
        StatusText = "Waiting...",
        Tools = {},
        ItemSeen = nil,
        ItemCooldown = 0,
    }

    setmetatable(ai, {__index = HunterAI})
    return ai
end

function HunterAI:UpdateLearning(playerPos, playerVelocity)
    local data = self.LearnedData

    -- Learn player speed
    local speed = playerVelocity.Magnitude
    data.PlayerSpeed = Lerp(data.PlayerSpeed, speed, CONFIG.LEARNING_RATE)

    -- Learn favorite areas
    local area = Vector3.new(
        math.floor(playerPos.X / 20) * 20,
        0,
        math.floor(playerPos.Z / 20) * 20
    )
    local areaKey = tostring(area)

    if not data.PlayerFavoriteAreas[areaKey] then
        data.PlayerFavoriteAreas[areaKey] = {Position = area, Visits = 0, IsHidingSpot = false}
    end
    data.PlayerFavoriteAreas[areaKey].Visits = data.PlayerFavoriteAreas[areaKey].Visits + 1

    -- Detect hiding behavior
    if speed < 2 then
        data.PlayerFavoriteAreas[areaKey].IsHidingSpot = true
        self.Alertness = math.min(100, self.Alertness + 5)
    end

    -- Learn escape direction
    if self.LastKnownPlayerPos then
        local escapeDir = (playerPos - self.LastKnownPlayerPos).Unit
        data.PlayerEscapeDirection = data.PlayerEscapeDirection:Lerp(escapeDir, 0.2)
    end

    self.LastKnownPlayerPos = playerPos
end

function HunterAI:GetBestFlankPosition(playerPos, hunterPos)
    -- Try to get ahead of the player based on their movement pattern
    local escapeDir = self.LearnedData.PlayerEscapeDirection
    local predictedPos = playerPos + escapeDir * 30

    -- Cast rays to check if position is accessible
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    if self.Model then
        rayParams.FilterDescendantsInstances = {self.Model}
    end

    -- Find ground
    local ray = Workspace:Raycast(predictedPos + Vector3.new(0, 10, 0), Vector3.new(0, -20, 0), rayParams)
    if ray then
        return ray.Position + Vector3.new(0, 3, 0)
    end

    return predictedPos
end

function HunterAI:ChooseStrategy()
    local player = Players.LocalPlayer
    local char = player.Character
    if not char then return "PATROL" end

    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return "PATROL" end

    local myRoot = self.Model and (self.Model:FindFirstChild("HumanoidRootPart") or self.Model.PrimaryPart)
    if not myRoot then return "PATROL" end

    local dist = (rootPart.Position - myRoot.Position).Magnitude
    local playerSpeed = self.LearnedData.PlayerSpeed
    local mySpeed = self.Config.Speed

    -- Can I outrun them?
    local canOutrun = mySpeed > playerSpeed

    if dist < 20 then
        if self.AbilityCooldown <= 0 then
            return "ABILITY"
        end
        return "CHASE"
    elseif dist < 60 then
        if canOutrun then
            return "CHASE"
        else
            return "FLANK"
        end
    elseif self.LastKnownPlayerPos and dist < 150 then
        -- Check if player might be hiding
        if playerSpeed < 2 then
            return "INVESTIGATE"
        end
        return "CHASE"
    else
        -- Look at favorite areas
        local bestArea = self:GetMostVisitedArea()
        if bestArea then
            return "SEARCH"
        end
        return "PATROL"
    end
end

function HunterAI:GetMostVisitedArea()
    local best = nil
    local bestVisits = 0

    for _, area in pairs(self.LearnedData.PlayerFavoriteAreas) do
        if area.Visits > bestVisits then
            bestVisits = area.Visits
            best = area
        end
    end

    return best
end

function HunterAI:ScanForItems()
    -- Hunter looks for items in the world to use
    local myRoot = self.Model and (self.Model:FindFirstChild("HumanoidRootPart") or self.Model.PrimaryPart)
    if not myRoot then return end

    -- Scan nearby tools
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Tool") and not obj.Parent:IsA("Model") then
            local handle = obj:FindFirstChild("Handle")
            if handle then
                local dist = (handle.WorldPosition - myRoot.Position).Magnitude
                if dist < 15 then
                    self.ItemSeen = obj
                    return obj
                end
            end
        end
    end

    return nil
end

function HunterAI:TryPickupItem(item)
    if not item or self.ItemCooldown > 0 then return end

    local myHumanoid = self.Model and self.Model:FindFirstChildOfClass("Humanoid")
    local myRoot = self.Model and (self.Model:FindFirstChild("HumanoidRootPart") or self.Model.PrimaryPart)
    if not myHumanoid or not myRoot then return end

    local handle = item:FindFirstChild("Handle")
    if handle then
        local dist = (handle.WorldPosition - myRoot.Position).Magnitude
        if dist < 5 then
            -- Move tool to hunter's character (simulate pickup)
            item.Parent = self.Model
            if myHumanoid then
                myHumanoid:EquipTool(item)
            end
            self.ItemCooldown = 10
            self.LearnedData.PlayerItemUsage[item.Name] = (self.LearnedData.PlayerItemUsage[item.Name] or 0) + 1
            self:UpdateStatus("Picked up " .. item.Name .. "!")
        end
    end
end

function HunterAI:UpdateStatus(text)
    self.StatusText = text
    -- Update UI
    for i, hunter in ipairs(GameState.Hunters) do
        if hunter.AI == self then
            local label = GameState.UIElements["HunterStatus_" .. i]
            if label then
                label.Text = text
            end
        end
    end
end

