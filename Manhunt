-- HUNTER BEHAVIOR UPDATE
-- ============================================================

local HunterBehavior = {}

function HunterBehavior:UpdateHunter(hunter, dt)
    if not hunter.Model then return end

    local ai = hunter.AI
    local humanoid = hunter.Model:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        ai:UpdateStatus("❌ Defeated")
        return
    end

    local char = LocalPlayer.Character
    if not char then return end

    local playerRoot = char:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return end

    local myRoot = hunter.Model:FindFirstChild("HumanoidRootPart") or hunter.Model.PrimaryPart
    if not myRoot then return end

    -- Update ability cooldown
    if ai.AbilityCooldown > 0 then
        ai.AbilityCooldown = ai.AbilityCooldown - dt
    end

    -- Update item cooldown
    if ai.ItemCooldown > 0 then
        ai.ItemCooldown = ai.ItemCooldown - dt
    end

    -- Don't act during countdown
    if GameState.Phase == "COUNTDOWN" then
        ai:UpdateStatus("Waiting for hunt...")
        return
    end

    local playerVel = char:FindFirstChild("HumanoidRootPart") and
        char.HumanoidRootPart.AssemblyLinearVelocity or Vector3.new()

    -- Learning update
    ai:UpdateLearning(playerRoot.Position, playerVel)

    -- Scan for items in world
    task.spawn(function()
        local item = ai:ScanForItems()
        if item and ai.ItemCooldown <= 0 then
            ai:TryPickupItem(item)
        end
    end)

    -- Choose and execute strategy
    local strategy = ai:ChooseStrategy()

    self:ExecuteStrategy(hunter, ai, strategy, humanoid, myRoot, playerRoot, dt)
end

function HunterBehavior:ExecuteStrategy(hunter, ai, strategy, humanoid, myRoot, playerRoot, dt)
    local dist = (playerRoot.Position - myRoot.Position).Magnitude

    if strategy == "CHASE" then
        -- Direct pathfinding to player
        self:PathfindTo(hunter, playerRoot.Position, humanoid)
        ai:UpdateStatus("🔴 Chasing!")
        humanoid.WalkSpeed = hunter.Config.Speed

    elseif strategy == "FLANK" then
        -- Try to get ahead of player
        local flankPos = ai:GetBestFlankPosition(playerRoot.Position, myRoot.Position)
        self:PathfindTo(hunter, flankPos, humanoid)
        ai:UpdateStatus("⚡ Flanking...")
        humanoid.WalkSpeed = hunter.Config.Speed * 1.1

    elseif strategy == "ABILITY" then
        -- Use special ability
        self:UseAbility(hunter, ai, humanoid, myRoot, playerRoot)

    elseif strategy == "SEARCH" then
        -- Search likely hiding spots
        local bestArea = ai:GetMostVisitedArea()
        if bestArea then
            self:PathfindTo(hunter, bestArea.Position + Vector3.new(0, 3, 0), humanoid)
            ai:UpdateStatus("🔍 Searching...")
        end

    elseif strategy == "INVESTIGATE" then
        -- Player stopped - they might be hiding
        if ai.LastKnownPlayerPos then
            self:PathfindTo(hunter, ai.LastKnownPlayerPos, humanoid)
            ai:UpdateStatus("👁 Investigating...")
        end

    elseif strategy == "PATROL" then
        -- Random patrol
        self:Patrol(hunter, ai, humanoid, myRoot)
        ai:UpdateStatus("👣 Patrolling...")
    end

    -- Attack if in range
    if dist < 5 and GameState.Phase == "HUNTING" then
        self:AttemptAttack(hunter, ai, humanoid, myRoot, playerRoot)
    end
end

function HunterBehavior:PathfindTo(hunter, targetPos, humanoid)
    if not humanoid then return end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentJumpHeight = 8,
        AgentMaxSlope = 45,
        Costs = {
            Water = 20,
        }
    })

    local myRoot = hunter.Model:FindFirstChild("HumanoidRootPart") or hunter.Model.PrimaryPart
    if not myRoot then return end

    task.spawn(function()
        local success, err = pcall(function()
            path:ComputeAsync(myRoot.Position, targetPos)
        end)

        if success and path.Status == Enum.PathStatus.Success then
            local waypoints = path:GetWaypoints()

            for i, waypoint in ipairs(waypoints) do
                if not hunter.Model or not hunter.Model.Parent then break end
                if not humanoid or humanoid.Health <= 0 then break end

                if waypoint.Action == Enum.PathWaypointAction.Jump then
                    humanoid.Jump = true
                end

                humanoid:MoveTo(waypoint.Position)

                local moved = humanoid.MoveToFinished:Wait(2)
                if not moved then break end
            end
        else
            -- Fallback: move directly
            if humanoid then
                humanoid:MoveTo(targetPos)
            end
        end
    end)
end

function HunterBehavior:Patrol(hunter, ai, humanoid, myRoot)
    if not humanoid then return end

    local char = LocalPlayer.Character
    local playerPos = char and char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Position

    -- Bias patrol toward player's general area
    local basePos = playerPos or myRoot.Position
    local patrolPos = basePos + Vector3.new(
        (math.random() - 0.5) * 80,
        0,
        (math.random() - 0.5) * 80
    )

    -- Find ground
    local ray = Workspace:Raycast(patrolPos + Vector3.new(0, 20, 0), Vector3.new(0, -40, 0))
    if ray then
        patrolPos = ray.Position + Vector3.new(0, 3, 0)
    end

    self:PathfindTo(hunter, patrolPos, humanoid)
end

function HunterBehavior:UseAbility(hunter, ai, humanoid, myRoot, playerRoot)
    if ai.AbilityCooldown > 0 then return end

    local abilityName = hunter.Config.Ability

    if abilityName == "SHADOW_STEP" then
        -- Teleport behind player
        ai:UpdateStatus("💨 SHADOW STEP!")
        ai.AbilityCooldown = hunter.Config.AbilityCooldown

        -- Flash effect
        task.spawn(function()
            local char = LocalPlayer.Character
            if not char then return end

            local playerRoot2 = char:FindFirstChild("HumanoidRootPart")
            if not playerRoot2 then return end

            -- Teleport to behind player
            local behindPos = playerRoot2.CFrame * CFrame.new(0, 0, 8)
            hunter.Model:SetPrimaryPartCFrame(
                CFrame.new(behindPos.Position + Vector3.new(0, 3, 0))
            )

            -- Visual effect
            local flash = Instance.new("Part")
            flash.Size = Vector3.new(4, 4, 4)
            flash.Material = Enum.Material.Neon
            flash.Color = hunter.Config.SecondaryColor
            flash.CFrame = hunter.Model:GetPrimaryPartCFrame()
            flash.CanCollide = false
            flash.Anchored = true
            flash.Parent = Workspace

            local shrink = CreateTween(flash, {Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1}, 0.5)
            shrink:Play()
            task.wait(0.5)
            flash:Destroy()
        end)

    elseif abilityName == "PHASE_WALK" then
        -- Phase through walls
        ai:UpdateStatus("👻 PHASE WALK!")
        ai.AbilityCooldown = hunter.Config.AbilityCooldown
        ai.IsPhasing = true

        task.spawn(function()
            -- Make parts non-collidable during phase
            for _, part in pairs(hunter.Model:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.Transparency = 0.6
                end
            end

            humanoid.WalkSpeed = hunter.Config.Speed * 1.5

            task.wait(3)

            -- Restore
            for _, part in pairs(hunter.Model:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                    part.Transparency = 0
                end
            end
            humanoid.WalkSpeed = hunter.Config.Speed
            ai.IsPhasing = false
            ai:UpdateStatus("Phase ended")
        end)

    elseif abilityName == "BLOOD_RAGE" then
        -- Speed and power boost
        ai:UpdateStatus("💢 BLOOD RAGE!")
        ai.AbilityCooldown = hunter.Config.AbilityCooldown
        ai.IsRaging = true

        task.spawn(function()
            local originalSpeed = hunter.Config.Speed
            humanoid.WalkSpeed = hunter.Config.Speed * 2

            -- Rage visual
            for _, part in pairs(hunter.Model:GetDescendants()) do
                if part:IsA("BasePart") then
                    local origColor = part.Color
                    local rageTween = CreateTween(part, {Color = Color3.fromRGB(255, 100, 0)}, 0.3)
                    rageTween:Play()
                end
            end

            task.wait(5)

            humanoid.WalkSpeed = originalSpeed
            ai.IsRaging = false

            for _, part in pairs(hunter.Model:GetDescendants()) do
                if part:IsA("BasePart") then
                    local restoreTween = CreateTween(part, {Color = hunter.Config.BodyColors.Torso or Color3.fromRGB(50, 0, 0)}, 0.3)
                    restoreTween:Play()
                end
            end
            ai:UpdateStatus("Rage ended")
        end)
    end
end

function HunterBehavior:AttemptAttack(hunter, ai, humanoid, myRoot, playerRoot)
    if ai.LearnedData.LastCaughtAttempt and tick() - ai.LearnedData.LastCaughtAttempt < 2 then return end
    ai.LearnedData.LastCaughtAttempt = tick()

    -- Deal damage to player's character
    local char = LocalPlayer.Character
    if not char then return end

    local playerHumanoid = char:FindFirstChildOfClass("Humanoid")
    if playerHumanoid and playerHumanoid.Health > 0 then
        local damage = ai.IsRaging and 30 or 15
        playerHumanoid:TakeDamage(damage)
        ai:UpdateStatus("⚔ ATTACKING!")

        -- Hit visual
        task.spawn(function()
            local hitEffect = Instance.new("Frame")
            hitEffect.Size = UDim2.new(1, 0, 1, 0)
            hitEffect.BackgroundColor3 = hunter.Config.SecondaryColor
            hitEffect.BackgroundTransparency = 0.5
            hitEffect.ZIndex = 90
            hitEffect.Parent = GameState.UIElements.ScreenGui

            local hitFade = CreateTween(hitEffect, {BackgroundTransparency = 1}, 0.4)
            hitFade:Play()
            task.wait(0.4)
            hitEffect:Destroy()
        end)

        -- Camera shake on hit
        task.spawn(function()
            CameraController:Shake(1, 0.3)
        end)
    end
end

