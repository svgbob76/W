            ["Shadow Compass"] = Color3.fromRGB(80, 0, 120),
            ["Spectral Spear"] = Color3.fromRGB(0, 200, 255),
            ["Phase Grenade"] = Color3.fromRGB(0, 100, 150),
            ["Echo Tracker"] = Color3.fromRGB(0, 150, 200),
            ["Infernal Axe"] = Color3.fromRGB(200, 50, 0),
            ["Rage Totem"] = Color3.fromRGB(150, 0, 0),
            ["Heat Seeker"] = Color3.fromRGB(255, 100, 0),
        }

        handle.Color = colorMap[toolName] or hunter.Config.Color
        handle.Material = Enum.Material.Neon
        handle.Parent = tool

        -- Add mesh for weapon look
