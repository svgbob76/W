local IntroSystem = {}

function IntroSystem:PlayIntro()
    GameState.IsIntroPlaying = true
    GameState.Phase = "INTRO"

    local elements = GameState.UIElements

    -- Start ambient sound
    local ambientSound = CreateSound(CONFIG.SOUNDS.AMBIENT, 0.3, 1, true)
    ambientSound:Play()

    -- Show blackout
    elements.Blackout.BackgroundTransparency = 0
    elements.Blackout.Visible = true

    -- Brief darkness
    task.wait(0.5)

    -- Fade in cinematic bars
    elements.TopBar.Visible = true
    elements.BottomBar.Visible = true

    local topTween = CreateTween(elements.TopBar, {Position = UDim2.new(0, 0, 0, 0)}, 0.8, Enum.EasingStyle.Back)
    local botTween = CreateTween(elements.BottomBar, {Position = UDim2.new(0, 0, 0.88, 0)}, 0.8, Enum.EasingStyle.Back)
    topTween:Play()
    botTween:Play()
    task.wait(0.5)

    -- Fade out blackout to reveal world
    local fadeOut = CreateTween(elements.Blackout, {BackgroundTransparency = 1}, 1.5, Enum.EasingStyle.Sine)
    fadeOut:Play()
    task.wait(1)

    -- Setup camera for cinematic
    CameraController:SaveState()
    CameraController:SetCinematic()

    -- Show title container
    elements.TitleContainer.Visible = true

    -- Animate title
    task.spawn(function()
        TextAnimator:TypeWrite(elements.TitleLabel, "MANHUNT", 0.08, Color3.fromRGB(255, 50, 50))
        task.wait(0.3)
        -- Expand accent line
        local lineTween = CreateTween(elements.AccentLine, {Size = UDim2.new(0.8, 0, 0, 3)}, 0.6, Enum.EasingStyle.Expo)
        lineTween:Play()
        task.wait(0.5)
        TextAnimator:TypeWrite(elements.SubtitleLabel, "ACROSS ROBLOX", 0.06, Color3.fromRGB(200, 200, 200))
    end)

    task.wait(3.5)

    -- Camera shake for dramatic effect
    local dramatic = CreateSound(CONFIG.SOUNDS.DRAMATIC, 0.8, 1)
    dramatic:Play()

    -- Now introduce each hunter
    for i, hunterData in ipairs(CONFIG.HUNTERS) do
        self:IntroduceHunter(i, hunterData)
        task.wait(0.5)
    end

    task.wait(1)

    -- ALL HUNTERS REVEALED - Final dramatic moment
    self:PlayFinalMoment()

    task.wait(2)

    -- Transition to gameplay
    self:TransitionToGame()

    ambientSound:Stop()
    ambientSound:Destroy()
    GameState.IsIntroPlaying = false
end

function IntroSystem:IntroduceHunter(index, hunterData)
    local elements = GameState.UIElements
    local hunter = GameState.Hunters[index]

    -- Camera sweep to hunter
    if hunter and hunter.Model then
