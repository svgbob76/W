local function createButton(text, color)
	local button = Instance.new("TextButton")
	button.BackgroundColor3 = color or Color3.fromRGB(36, 39, 50)
	button.TextColor3 = Color3.fromRGB(245, 245, 255)
	button.Font = Enum.Font.GothamBold
	button.TextSize = 15
	button.TextWrapped = true
	button.BorderSizePixel = 0
	button.Size = UDim2.new(1, 0, 0, 38)
	button.AutoButtonColor = true
	button.LayoutOrder = nextOrder()
	button.Parent = scroll

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = button

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(75, 80, 100)
	stroke.Thickness = 1.1
	stroke.Parent = button

	button.Text = text

	return button
end

local function makeToggle(name, text, color, callback)
	local button = createButton(text, color)
	button.Name = name
	button:SetAttribute("BaseText", text)

	toggles[name] = button
	updateToggle(name, false)

	button.MouseButton1Click:Connect(callback)

	return button
end

local function makeAction(text, color, callback)
	local button = createButton(text, color)

	button.MouseButton1Click:Connect(function()
		callback()

		local oldColor = button.BackgroundColor3
		button.BackgroundColor3 = Color3.fromRGB(90, 95, 120)

		task.delay(0.12, function()
			if button and button.Parent then
				button.BackgroundColor3 = oldColor
			end
		end)
	end)

	return button
end

local function makeHoldButton(text, color, setFunction)
	local button = createButton(text, color)

	local function press()
		setFunction(true)
		button.BackgroundColor3 = Color3.fromRGB(90, 95, 120)
	end

	local function release()
		setFunction(false)
		button.BackgroundColor3 = Color3.fromRGB(36, 39, 50)
	end

	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			press()
		end
	end)

	button.InputEnded:Connect(function()
		release()
	end)

	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)

	return button
end

