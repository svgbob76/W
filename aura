-- FRAME LOOPS
-----------------------------------------------------------

local cachedChar = nil
local cachedParts = {}
local cachedConn = nil

local function getCharParts()
	local char = getCharacter()

	if not char then
		return {}
	end

	if cachedChar ~= char then
		if cachedConn then
			cachedConn:Disconnect()
		end

		cachedChar = char
		cachedParts = {}

		for _, part in char:GetDescendants() do
			if part:IsA("BasePart") then
				table.insert(cachedParts, part)
			end
		end

		cachedConn = char.DescendantAdded:Connect(function(obj)
			if obj:IsA("BasePart") then
				table.insert(cachedParts, obj)
			end
		end)
	end

	return cachedParts
end

RunService.RenderStepped:Connect(function()
	local char, hum, root = getCharacter()
	if not char or not hum or not root then
		return
	end

	camera = workspace.CurrentCamera or camera

	if states.NoClip then
		local move = hum.MoveDirection
		local camCF = camera.CFrame

		local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
		if flatLook.Magnitude > 0.001 then
			flatLook = flatLook.Unit
		else
			flatLook = Vector3.new(0, 0, -1)
		end

		local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
		if flatRight.Magnitude > 0.001 then
			flatRight = flatRight.Unit
		else
			flatRight = Vector3.new(1, 0, 0)
		end

		local forward = move:Dot(flatLook)
		local right = move:Dot(flatRight)

		local vertical = 0

		if noclipUp then
			vertical = vertical + 1
		end

		if noclipDown then
			vertical = vertical - 1
		end

		local input = Vector3.new(right, vertical, forward)

		if input.Magnitude > 1 then
			input = input.Unit
		end

		local worldDirection = camCF:VectorToWorldSpace(input)

		local speed = 65

		if states.SlowMo then
			speed = 16
		end

		if states.Overdrive then
			speed = 90
		end

		root.AssemblyLinearVelocity = worldDirection * speed

		local flatWorld = Vector3.new(worldDirection.X, 0, worldDirection.Z)

		if flatWorld.Magnitude > 0.1 then
			local target = CFrame.lookAt(root.Position, root.Position + flatWorld.Unit)
			root.CFrame = root.CFrame:Lerp(target, 0.25)
		end
	end
end)

RunService.Heartbeat:Connect(function()
	local char = getCharacter()
	if not char then
		return
	end

	if states.SlowMo and not states.Overdrive then
		for _, part in ipairs(getCharParts()) do
			if part and part.Parent then
				local linearVelocity = part.AssemblyLinearVelocity
				local maxLinear = 9

				if linearVelocity.Magnitude > maxLinear then
					part.AssemblyLinearVelocity = linearVelocity.Unit * maxLinear
				end

				local angularVelocity = part.AssemblyAngularVelocity
				local maxAngular = 4

				if angularVelocity.Magnitude > maxAngular then
					part.AssemblyAngularVelocity = angularVelocity.Unit * maxAngular
				end
			end
		end
	end
end)

