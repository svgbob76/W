local function resetAll()
	states.SlowMo = false
	states.Ragdoll = false
	states.NoClip = false
	states.AirJump = false
	states.Shield = false
	states.Overdrive = false

	noclipUp = false
	noclipDown = false

	setSlowVisual(false)
	updateAllToggles()

	task.wait(0.25)

	refreshMovement()
end

player.CharacterAdded:Connect(function(char)
	char:WaitForChild("HumanoidRootPart", 5) or char:WaitForChild("Torso", 5)
	resetAll()
end)

if player.Character then
	task.spawn(resetAll)
end
