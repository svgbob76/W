-----------------------------------------------------------
-- STATE
-----------------------------------------------------------

local states = {
	SlowMo = false,
	Ragdoll = false,
	NoClip = false,
	AirJump = false,
	Shield = false,
	Overdrive = false,
}

local noclipUp = false
local noclipDown = false

local toggles = {}
local lastTimes = {}
local burstToken = 0

-----------------------------------------------------------
-- HELPERS
-----------------------------------------------------------

local function getCharacter()
	local char = player.Character
	if not char then
		return nil
	end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")

	if not hum or not root then
		return nil
	end

	return char, hum, root
end

local function setJumpVelocity(hum, velocity)
	if not hum then
		return
	end

	if hum.UseJumpPower then
		hum.JumpPower = velocity
	else
		hum.JumpHeight = (velocity * velocity) / (2 * math.max(workspace.Gravity, 1))
	end
end

local function getJumpVelocity(hum)
	if not hum then
		return 50
	end

	if hum.UseJumpPower then
		return hum.JumpPower
	end

	return math.sqrt(2 * math.max(workspace.Gravity, 1) * hum.JumpHeight)
end

local function refreshMovement()
	local char, hum, root = getCharacter()
	if not hum then
		return
	end

	if states.Ragdoll then
		hum.WalkSpeed = 0
		setJumpVelocity(hum, 0)
		return
	end

	local speed = 16
	local jump = 50

	if states.Overdrive then
		speed = 42
		jump = 85
	elseif states.SlowMo then
		speed = 6
		jump = 20
	end

	hum.WalkSpeed = speed
	setJumpVelocity(hum, jump)
end

local function setSlowVisual(on)
	if on then
		local cc = Lighting:FindFirstChild("CAFSlowCC")
		if not cc then
			cc = Instance.new("ColorCorrectionEffect")
			cc.Name = "CAFSlowCC"
			cc.Parent = Lighting
		end

		cc.Contrast = 0.18
		cc.Saturation = 0.08
		cc.Brightness = 0.02
		cc.TintColor = Color3.fromRGB(215, 230, 255)

		local blur = Lighting:FindFirstChild("CAFSlowBlur")
		if not blur then
			blur = Instance.new("BlurEffect")
			blur.Name = "CAFSlowBlur"
			blur.Parent = Lighting
		end

		blur.Size = 3

		TweenService:Create(camera, TweenInfo.new(0.35), {
			FieldOfView = 56,
		}):Play()
	else
		local cc = Lighting:FindFirstChild("CAFSlowCC")
		if cc then
			cc:Destroy()
		end

		local blur = Lighting:FindFirstChild("CAFSlowBlur")
		if blur then
			blur:Destroy()
		end

		TweenService:Create(camera, TweenInfo.new(0.3), {
			FieldOfView = 70,
		}):Play()
	end
end

local function saveCollision(part)
	if part:GetAttribute("CAFOrigCollide") == nil then
		part:SetAttribute("CAFOrigCollide", part.CanCollide)
	end
end

local function restoreCollision(char)
	for _, obj in char:GetDescendants() do
		if obj:IsA("BasePart") then
			local original = obj:GetAttribute("CAFOrigCollide")
			if original ~= nil then
				obj.CanCollide = original
			end
		end
	end
end

local function effectsFolder()
	local folder = workspace:FindFirstChild("CAFEffects")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "CAFEffects"
		folder.Parent = workspace
	end
	return folder
end

local function spawnParticles(parent, color, duration, rate, size)
	if not parent then
		return
	end

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Rate = rate or 100
	emitter.Lifetime = NumberRange.new(0.35, 0.9)
	emitter.Speed = NumberRange.new(3, 10)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Color = ColorSequence.new(color or Color3.fromRGB(180, 120, 255))
	emitter.Size = NumberSequence.new(size or 0.35, 0)
	emitter.Transparency = NumberSequence.new(0.2, 1)
	emitter.LightEmission = 1
	emitter.Parent = parent

	emitter:Emit(25)

	task.delay(0.15, function()
		if emitter and emitter.Parent then
			emitter.Rate = 0
		end
	end)

	Debris:AddItem(emitter, duration or 1.2)
end

local function spawnLight(parent, color, range, brightness, duration)
	if not parent then
		return
	end

	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range or 12
	light.Brightness = brightness or 2
	light.Parent = parent

	Debris:AddItem(light, duration or 1)
end

local function spawnTrail(root, color, duration)
	if not root then
		return
	end

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent = root

	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -1, 0)
	a1.Parent = root

	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.3
	trail.MinLength = 0.1
	trail.Color = ColorSequence.new(color)
	trail.LightEmission = 1
	trail.Parent = root

	Debris:AddItem(trail, duration or 0.75)
	Debris:AddItem(a0, duration + 0.75)
	Debris:AddItem(a1, duration + 0.75)
end

local function applyBodyVelocity(root, velocity, duration)
	if not root then
		return
	end

	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(1000000, 1000000, 1000000)
	bv.Velocity = velocity
	bv.Parent = root

	Debris:AddItem(bv, duration or 0.25)
end

local function applyAngularVelocity(root, angularVelocity, duration)
	if not root then
		return
	end

	local attachment = root:FindFirstChild("CAFAngularAttach")
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "CAFAngularAttach"
		attachment.Parent = root
	end

	local av = Instance.new("AngularVelocity")
	av.Attachment0 = attachment
	av.MaxTorque = Vector3.new(1000000, 1000000, 1000000)
	av.AngularVelocity = angularVelocity
	av.Parent = root

	Debris:AddItem(av, duration or 0.3)
end

local function shakeCamera(preset, magnitude)
	pcall(function()
		camera:Shake(preset, magnitude or 1)
	end)
end

local function shockwave(root, color, maxSize)
	if not root then
		return
	end

	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.35
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Size = Vector3.new(1, 1, 1)
	part.CFrame = root.CFrame * CFrame.new(0, -2, 0)
	part.Parent = effectsFolder()

	TweenService:Create(part, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(maxSize, maxSize, maxSize),
		Transparency = 1,
	}):Play()

	Debris:AddItem(part, 0.8)
end

-----------------------------------------------------------
-- RAGDOLL
-----------------------------------------------------------

local function applyRagdoll(enable)
	local char, hum, root = getCharacter()
	if not char or not hum or not root then
		return
	end

	if enable then
		if char:GetAttribute("CAFRagdolled") then
			return
		end

		char:SetAttribute("CAFRagdolled", true)

		for _, part in char:GetDescendants() do
			if part:IsA("BasePart") then
				saveCollision(part)
			end
		end

		for _, part in char:GetDescendants() do
			if part:IsA("BasePart") then
				part.CanCollide = part ~= root
			end
		end

		local folder = char:FindFirstChild("CAFRagdollFolder")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "CAFRagdollFolder"
			folder.Parent = char
		end

		for _, motor in char:GetDescendants() do
			if motor:IsA("Motor6D") and motor.Part0 and motor.Part1 then
				motor.Enabled = false

				local a0 = Instance.new("Attachment")
				a0.CFrame = motor.C0
				a0.Name = "CAFRagdollAtt"
				a0:SetAttribute("CAFRagdollAtt", true)
				a0.Parent = motor.Part0

				local a1 = Instance.new("Attachment")
				a1.CFrame = motor.C1
				a1.Name = "CAFRagdollAtt"
				a1:SetAttribute("CAFRagdollAtt", true)
				a1.Parent = motor.Part1

				local ballSocket = Instance.new("BallSocketConstraint")
				ballSocket.Name = "CAFRagdoll_" .. motor.Name
				ballSocket.Attachment0 = a0
				ballSocket.Attachment1 = a1
				ballSocket.LimitsEnabled = false
				ballSocket.Parent = folder
			end
		end

		hum.PlatformStand = true
		hum.AutoRotate = false
		hum.WalkSpeed = 0
		setJumpVelocity(hum, 0)
		hum:ChangeState(Enum.HumanoidStateType.Physics)

		root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + Vector3.new(
			math.random(-4, 4),
			8,
			math.random(-4, 4)
		)

		root.AssemblyAngularVelocity = root.AssemblyAngularVelocity + Vector3.new(
			math.random(-3, 3),
			math.random(-3, 3),
			math.random(-3, 3)
		)
	else
		if not char:GetAttribute("CAFRagdolled") then
			return
		end

		char:SetAttribute("CAFRagdolled", false)

		local rootMotor = nil

		for _, motor in char:GetDescendants() do
			if motor:IsA("Motor6D") and (motor.Name == "Root" or motor.Part0 == root) then
				rootMotor = motor
				break
			end
		end

		local torso = char:FindFirstChild("LowerTorso")
			or char:FindFirstChild("Torso")
			or char:FindFirstChild("UpperTorso")

		if rootMotor and torso and root then
			pcall(function()
				root.CFrame = torso.CFrame * rootMotor.C1 * rootMotor.C0:Inverse()
			end)
		end

		local folder = char:FindFirstChild("CAFRagdollFolder")
		if folder then
			folder:Destroy()
		end

		for _, motor in char:GetDescendants() do
			if motor:IsA("Motor6D") then
				motor.Enabled = true
			end
		end

		for _, obj in char:GetDescendants() do
			if obj:IsA("Attachment") and obj:GetAttribute("CAFRagdollAtt") then
				obj:Destroy()
			end
		end

		restoreCollision(char)

		hum.PlatformStand = false
		hum.AutoRotate = true
		hum:ChangeState(Enum.HumanoidStateType.Running)
	end
end

-----------------------------------------------------------
-- NOCLIP / WALL PHASE
-----------------------------------------------------------

local function applyNoClip(enable)
	local char, hum, root = getCharacter()
	if not char or not hum or not root then
		return
	end

	if enable then
		if char:GetAttribute("CAFNoClipped") then
			return
		end

		char:SetAttribute("CAFNoClipped", true)

		for _, part in char:GetDescendants() do
			if part:IsA("BasePart") then
				saveCollision(part)
				part.CanCollide = false
			end
		end

		hum.PlatformStand = true
		hum.AutoRotate = false
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	else
		if not char:GetAttribute("CAFNoClipped") then
			return
		end

		char:SetAttribute("CAFNoClipped", false)

		restoreCollision(char)

		hum.PlatformStand = false
		hum.AutoRotate = true
		hum:ChangeState(Enum.HumanoidStateType.Running)

		root.AssemblyLinearVelocity = Vector3.zero

		noclipUp = false
		noclipDown = false
	end
end

-----------------------------------------------------------
-- GUI STATE UPDATER
-----------------------------------------------------------

local function updateToggle(name, on)
	local button = toggles[name]
	if not button then
		return
	end

	local baseText = button:GetAttribute("BaseText") or button.Text
	button.Text = baseText .. (on and " ON" or " OFF")

	local stroke = button:FindFirstChildOfClass("UIStroke")

	if on then
		button.BackgroundColor3 = Color3.fromRGB(25, 110, 75)
		if stroke then
			stroke.Color = Color3.fromRGB(90, 255, 170)
		end
	else
		button.BackgroundColor3 = Color3.fromRGB(36, 39, 50)
		if stroke then
			stroke.Color = Color3.fromRGB(75, 80, 100)
		end
	end
end

local function updateAllToggles()
	for name, _ in pairs(toggles) do
		updateToggle(name, states[name] or false)
	end
end

-----------------------------------------------------------
-- MOVES
-----------------------------------------------------------

local function defaultWalk()
	local char, hum, root = getCharacter()

	applyRagdoll(false)
	applyNoClip(false)

	states.SlowMo = false
	states.Ragdoll = false
	states.NoClip = false
	states.Overdrive = false
	states.AirJump = false

	setSlowVisual(false)
	refreshMovement()

	updateToggle("SlowMo", false)
	updateToggle("Ragdoll", false)
	updateToggle("NoClip", false)
	updateToggle("AirJump", false)

	if root then
		spawnParticles(root, Color3.fromRGB(255, 255, 255), 0.5, 60, 0.25)
	end
end

local function doge(direction)
	local char, hum, root = getCharacter()
	if not root or states.Ragdoll then
		return
	end

	local now = tick()
	if lastTimes.Doge and now - lastTimes.Doge < 0.18 then
		return
	end

	lastTimes.Doge = now

	local dir

	if direction == "Left" then
		dir = -root.CFrame.RightVector
	elseif direction == "Right" then
		dir = root.CFrame.RightVector
	else
		dir = -root.CFrame.LookVector
	end

	dir = Vector3.new(dir.X, 0, dir.Z)

	if dir.Magnitude > 0 then
		dir = dir.Unit
	end

	if states.NoClip then
		root.CFrame = root.CFrame + dir * 18

		local spin

		if direction == "Left" then
			spin = Vector3.new(0, -28, 0)
		elseif direction == "Right" then
			spin = Vector3.new(0, 28, 0)
		else
			spin = root.CFrame.RightVector * -24
		end

		applyAngularVelocity(root, spin, 0.3)
		spawnTrail(root, Color3.fromRGB(120, 200, 255), 0.5)
		spawnParticles(root, Color3.fromRGB(120, 200, 255), 0.6, 80, 0.3)
		shakeCamera(Enum.CameraShakePresets.Bump, 0.35)

		return
	end

	local velocity = dir * 85 + Vector3.new(
		0,
		math.max(root.AssemblyLinearVelocity.Y, 0) + 12,
		0
	)

	applyBodyVelocity(root, velocity, 0.24)

	local spin

	if direction == "Left" then
		spin = Vector3.new(0, -28, 0)
	elseif direction == "Right" then
		spin = Vector3.new(0, 28, 0)
	else
		spin = root.CFrame.RightVector * -24
	end

	applyAngularVelocity(root, spin, 0.3)
	spawnTrail(root, Color3.fromRGB(120, 200, 255), 0.5)
	spawnParticles(root, Color3.fromRGB(120, 200, 255), 0.6, 80, 0.3)
	shakeCamera(Enum.CameraShakePresets.Bump, 0.35)
end

local function auraBurst()
	local char, hum, root = getCharacter()
	if not root or states.Ragdoll then
		return
	end

	local now = tick()
	if lastTimes.Burst and now - lastTimes.Burst < 6 then
		return
	end

	lastTimes.Burst = now

	states.Overdrive = true
	refreshMovement()

	burstToken = burstToken + 1
	local myToken = burstToken

	spawnParticles(root, Color3.fromRGB(255, 200, 60), 3, 220, 0.55)
	spawnLight(root, Color3.fromRGB(255, 200, 60), 16, 3, 5)
	spawnTrail(root, Color3.fromRGB(255, 200, 60), 4)

	TweenService:Create(camera, TweenInfo.new(0.25), {
		FieldOfView = 82,
	}):Play()

	shakeCamera(Enum.CameraShakePresets.Explosion, 0.65)

	root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + Vector3.new(0, 35, 0)

	task.delay(5, function()
		if burstToken ~= myToken then
			return
		end

		states.Overdrive = false
		refreshMovement()

		if states.SlowMo then
			setSlowVisual(true)
		else
			TweenService:Create(camera, TweenInfo.new(0.4), {
				FieldOfView = 70,
			}):Play()
		end
	end)
end

local function phantomDash()
	local char, hum, root = getCharacter()
	if not root or states.Ragdoll then
		return
	end

	local now = tick()
	if lastTimes.Dash and now - lastTimes.Dash < 0.5 then
		return
	end

	lastTimes.Dash = now

	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)

	if flat.Magnitude > 0 then
		flat = flat.Unit
	end

	if states.NoClip then
		root.CFrame = root.CFrame + flat * 30
		spawnTrail(root, Color3.fromRGB(170, 90, 255), 0.7)
		spawnParticles(root, Color3.fromRGB(170, 90, 255), 0.7, 140, 0.4)
		shakeCamera(Enum.CameraShakePresets.Bump, 0.45)
		return
	end

	local velocity = flat * 130 + Vector3.new(
		0,
		math.max(root.AssemblyLinearVelocity.Y, 0) + 10,
		0
	)

	applyBodyVelocity(root, velocity, 0.2)
	spawnTrail(root, Color3.fromRGB(170, 90, 255), 0.7)
	spawnParticles(root, Color3.fromRGB(170, 90, 255), 0.7, 140, 0.4)
	shakeCamera(Enum.CameraShakePresets.Bump, 0.45)
end

local function titanStomp()
	local char, hum, root = getCharacter()
	if not root or states.Ragdoll then
		return
	end

	local now = tick()
	if lastTimes.Stomp and now - lastTimes.Stomp < 2.2 then
		return
	end

	lastTimes.Stomp = now

	if states.NoClip then
		shockwave(root, Color3.fromRGB(255, 120, 40), 24)
		spawnParticles(root, Color3.fromRGB(255, 120, 40), 0.8, 180, 0.6)
		shakeCamera(Enum.CameraShakePresets.Explosion, 1)
		return
	end

	local grounded = hum.FloorMaterial ~= Enum.Material.Air

	if grounded then
		root.AssemblyLinearVelocity = Vector3.new(
			root.AssemblyLinearVelocity.X,
			-10,
			root.AssemblyLinearVelocity.Z
		)

		shockwave(root, Color3.fromRGB(255, 120, 40), 22)
		spawnParticles(root, Color3.fromRGB(255, 120, 40), 0.8, 180, 0.6)
		shakeCamera(Enum.CameraShakePresets.Explosion, 1)
	else
		applyBodyVelocity(root, Vector3.new(
			root.AssemblyLinearVelocity.X,
			-180,
			root.AssemblyLinearVelocity.Z
		), 0.16)

		spawnTrail(root, Color3.fromRGB(255, 120, 40), 0.4)

		task.delay(0.25, function()
			local _, _, currentRoot = getCharacter()
			if currentRoot then
				shockwave(currentRoot, Color3.fromRGB(255, 120, 40), 30)
				shakeCamera(Enum.CameraShakePresets.Explosion, 1.2)
			end
		end)
	end
end

local function applyShield(enable)
	local char, hum, root = getCharacter()
	if not char then
		return
	end

	if enable then
		local forceField = char:FindFirstChild("CAFShield")
		if not forceField then
			forceField = Instance.new("ForceField")
			forceField.Name = "CAFShield"
			forceField.Parent = char
		end

		forceField.Visible = true

		if root then
			spawnParticles(root, Color3.fromRGB(70, 190, 255), 1.2, 120, 0.45)
			spawnLight(root, Color3.fromRGB(70, 190, 255), 12, 2, 1.2)
		end
	else
		local forceField = char:FindFirstChild("CAFShield")
		if forceField then
			forceField:Destroy()
		end
	end
end

