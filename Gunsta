-- MAIN GAME LOOP
-- =============================================
local animFrameTimer = 0
local animFrameIndex = 1
local shootAnimFrameIndex = 1
local shootAnimTimer = 0

RunService.Heartbeat:Connect(function(dt)
    -- Update stopmotion animation
    animFrameTimer = animFrameTimer + dt
    
    -- Determine current animation based on player state
    local currentAnimName = "idle"
    if isMounted then
        currentAnimName = "mount"
    elseif Humanoid.MoveDirection.Magnitude > 0.1 then
        currentAnimName = "walk"
    end
    
    if isShootAnim then
        -- Shoot animation overrides
        shootAnimTimer = shootAnimTimer + dt
        local shootData = customAnimations.shoot
        if shootAnimTimer >= shootData.speed then
            shootAnimTimer = 0
            shootAnimFrameIndex = shootAnimFrameIndex + 1
            if shootAnimFrameIndex > #shootData.frames then
                shootAnimFrameIndex = 1
                isShootAnim = false
            end
            applyStopMotionFrame("shoot", shootAnimFrameIndex)
        end
    else
        -- Regular animations with stopmotion frames
        local animData = customAnimations[currentAnimName]
        if animData and animFrameTimer >= animData.speed then
            animFrameTimer = 0
            animFrameIndex = animFrameIndex % #animData.frames + 1
            applyStopMotionFrame(currentAnimName, animFrameIndex)
        end
    end
    
    -- Update lip sync
    updateLipSync(dt)
    
    -- Update stats display every 0.5 seconds
    frameCounter = frameCounter + dt
    if frameCounter >= 0.5 then
        frameCounter = 0
        updateStats()
        
        -- Cleanup dead NPCs from tables
        for npc, _ in pairs(frozenNPCs) do
            if not npc.Parent then
                frozenNPCs[npc] = nil
            end
        end
        for npc, _ in pairs(loyalistNPCs) do
            if not npc.Parent then
                loyalistNPCs[npc] = nil
            end
        end
    end
    
    -- Keep gun weld animated (slight bob)
    if gunWeld and isEquipped then
        local t = tick()
        gunWeld.C0 = CFrame.new(0, -1 + math.sin(t * 3) * 0.02, 0) * 
            CFrame.Angles(math.rad(90 + math.sin(t * 2) * 1), 0, 0)
    end
end)

