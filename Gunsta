-- =============================================
-- GUN EQUIP SYSTEM
-- =============================================
local equippedGunModel = nil
local gunWeld = nil

local function unequipCurrentGun()
    if equippedGunModel then
        equippedGunModel:Destroy()
        equippedGunModel = nil
        gunWeld = nil
    end
    isEquipped = false
    currentGun = nil
end

local function equipGun(gunIndex)
    unequipCurrentGun()
    
    local rightHand = Character:FindFirstChild("Right Arm") or Character:FindFirstChild("RightHand")
    if not rightHand then return end
    
    local gunModel
    if gunIndex == 1 then
        gunModel = createFreezeGun()
    elseif gunIndex == 2 then
        gunModel = createChannelingGun()
    elseif gunIndex == 3 then
        gunModel = createMountGun()
    end
    
    if not gunModel then return end
    
    gunModel.Parent = Character
    
    -- Weld to right arm
    local handle = gunModel:FindFirstChild("Handle") or gunModel.PrimaryPart
    if handle then
        local weld = Instance.new("Motor6D")
        weld.Part0 = rightHand
        weld.Part1 = handle
        
        -- Position gun in hand
        weld.C0 = CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(90), 0, 0)
        weld.C1 = CFrame.new(0, 0, 0)
        weld.Parent = rightHand
        
        equippedGunModel = gunModel
