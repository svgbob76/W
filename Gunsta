-- FREEZE GUN EFFECTS
-- =============================================
local function freezeNPC(npc)
    if not npc or frozenNPCs[npc] then return end
    
    local humanoid = npc:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    frozenNPCs[npc] = {
        walkSpeed = humanoid.WalkSpeed,
        jumpPower = humanoid.JumpPower
    }
    
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    
    -- Freeze visual effect - ice coating
    local frozenParts = {}
    for _, part in pairs(npc:GetDescendants()) do
        if part:IsA("BasePart") then
            local iceOverlay = Instance.new("SelectionBox")
            iceOverlay.Adornee = part
            iceOverlay.Color3 = Color3.fromRGB(100, 200, 255)
            iceOverlay.LineThickness = 0.05
            iceOverlay.SurfaceTransparency = 0.7
            iceOverlay.SurfaceColor3 = Color3.fromRGB(150, 220, 255)
            iceOverlay.Parent = part
            table.insert(frozenParts, iceOverlay)
            
            -- Tint the part
            if part:IsA("Part") or part:IsA("MeshPart") then
                local origColor = part.Color
                part.Color = Color3.fromRGB(
                    origColor.R * 255 * 0.5 + 130,
                    origColor.G * 255 * 0.5 + 180,
                    origColor.B * 255 * 0.5 + 220
                )
            end
        end
    end
    
    -- Freeze particles
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if hrp then
        local attachment = Instance.new("Attachment")
        attachment.Parent = hrp
        
        local particles = Instance.new("ParticleEmitter")
        particles.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(200, 240, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 180, 255))
        }
        particles.LightEmission = 0.5
        particles.Size = NumberSequence.new{
            NumberSequenceKeypoint.new(0, 0.3),
            NumberSequenceKeypoint.new(1, 0)
        }
        particles.Lifetime = NumberRange.new(1, 2)
        particles.Rate = 20
        particles.SpreadAngle = Vector2.new(180, 180)
        particles.Speed = NumberRange.new(1, 3)
        particles.Parent = attachment
        
        frozenNPCs[npc].attachment = attachment
        frozenNPCs[npc].parts = frozenParts
        
        -- Auto unfreeze after 15 seconds
        task.delay(15, function()
            if frozenNPCs[npc] then
                humanoid.WalkSpeed = frozenNPCs[npc].walkSpeed
                humanoid.JumpPower = frozenNPCs[npc].jumpPower
                
                for _, sel in pairs(frozenParts) do
                    sel:Destroy()
                end
                
                if attachment then attachment:Destroy() end
                frozenNPCs[npc] = nil
            end
        end)
    end
    
    -- Ice crack effect at NPC position
    if hrp then
        local iceEffect = Instance.new("Part")
        iceEffect.Size = Vector3.new(5, 0.1, 5)
        iceEffect.Anchored = true
        iceEffect.CanCollide = false
        iceEffect.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 3, hrp.Position.Z)
        iceEffect.BrickColor = BrickColor.new("Cyan")
        iceEffect.Material = Enum.Material.Glass
        iceEffect.Transparency = 0.4
        iceEffect.Parent = Workspace
        
        TweenService:Create(iceEffect, TweenInfo.new(1), {
            Transparency = 1,
            Size = Vector3.new(8, 0.05, 8)
        }):Play()
        
        game:GetService("Debris"):AddItem(iceEffect, 2)
    end
    
    print("[NPC Master] NPC Frozen: " .. npc.Name)
end

