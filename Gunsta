    return {
        weld = mountWeld,
        gui = mountGui,
        hud = mountHUD,
        steerConn = steerConnection,
        dust = dustAttach
    }
end

local mountData = nil

local function dismountNPC()
    if not isMounted or not mountedNPC then return end
    
    -- Remove weld
    local npcHRP = mountedNPC:FindFirstChild("HumanoidRootPart")
    if npcHRP then
        local weld = npcHRP:FindFirstChild("MountWeld")
        if weld then weld:Destroy() end
        
        local dustAttach = npcHRP:FindFirstChild("MountDust")
        if dustAttach then dustAttach:Destroy() end
        
        local mountIndicator = npcHRP:FindFirstChild("MountIndicator") 
        if mountIndicator then mountIndicator:Destroy() end
        
        -- Stop NPC
        local npcHumanoid = mountedNPC:FindFirstChildOfClass("Humanoid")
        if npcHumanoid then
            npcHumanoid.WalkSpeed = 16
        end
    end
    
    -- Restore player
    Humanoid.WalkSpeed = 16
    Humanoid.JumpPower = 50
    Humanoid.Sit = false
    
    -- Remove HUD
    local playerGui = Player.PlayerGui
    local mountHUD = playerGui:FindFirstChild("MountHUD")
    if mountHUD then mountHUD:Destroy() end
    
    -- Teleport player off NPC
    if npcHRP then
        HumanoidRootPart.CFrame = npcHRP.CFrame * CFrame.new(0, 5, 3)
    end
    
    isMounted = false
    mountedNPC = nil
    
    print("[NPC Master] Dismounted!")
end

