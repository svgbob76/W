local function updateLipSync(dt)
    lipTimer = lipTimer + dt
    if lipTimer >= LIP_SPEED then
        lipTimer = 0
        lipFrame = lipFrame % #lipFrames + 1
        local lf = lipFrames[lipFrame]
        
        if isTalking then
            mouthFrame.Size = UDim2.new(0.5 * lf.scaleX, 0, 0.4 * lf.scaleY, 0)
            mouthInner.BackgroundColor3 = Color3.fromRGB(
                200 + math.random(-20, 20),
                50 + math.random(-10, 10),
                50 + math.random(-10, 10)
            )
        else
            mouthFrame.Size = UDim2.new(0.5, 0, 0.15, 0)
        end
    end
end

