UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    -- Gun selection
    if input.KeyCode == Enum.KeyCode.One then
        if currentGun == 1 then
            unequipCurrentGun()
            updateGunSlotHighlight(0)
            showNotification("❄️ Freeze Gun Unequipped", Color3.fromRGB(0, 200, 255))
        else
            equipGun(1)
            updateGunSlotHighlight(1)
            showNotification("❄️ Freeze Gun Equipped! Click to freeze NPCs", Color3.fromRGB(0, 200, 255))
        end
    end
    
    if input.KeyCode == Enum.KeyCode.Two then
        if currentGun == 2 then
            unequipCurrentGun()
            updateGunSlotHighlight(0)
            showNotification("✨ Channeling Gun Unequipped", Color3.fromRGB(255, 0, 255))
        else
            equipGun(2)
            updateGunSlotHighlight(2)
            showNotification("✨ Channeling Gun Equipped! Shoot NPCs or the SKY for global control!", Color3.fromRGB(255, 0, 255))
        end
    end
    
    if input.KeyCode == Enum.KeyCode.Three then
        if currentGun == 3 then
            unequipCurrentGun()
            updateGunSlotHighlight(0)
            showNotification("🔗 Mount Gun Unequipped", Color3.fromRGB(255, 140, 0))
        else
            equipGun(3)
            updateGunSlotHighlight(3)
            showNotification("🔗 Mount Gun Equipped! Shoot an NPC to ride it!", Color3.fromRGB(255, 140, 0))
        end
    end
    
    -- Shoot
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if currentGun == 1 and isEquipped then
            shootFreezeGun()
            isShootAnim = true
        elseif currentGun == 2 and isEquipped then
            shootChannelingGun()
            isShootAnim = true
        elseif currentGun == 3 and isEquipped then
            shootMountGun()
            isShootAnim = true
        end
    end
    
    -- Dismount
    if input.KeyCode == Enum.KeyCode.E then
        if isMounted then
            dismountNPC()
            showNotification("🐴 Dismounted!", Color3.fromRGB(255, 200, 0))
        end
    end
    
    -- Unfreeze nearest NPC (G key)
    if input.KeyCode == Enum.KeyCode.G then
        local unfrozen = false
        for npc, data in pairs(frozenNPCs) do
            if npc and npc.Parent then
                local humanoid = npc:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid.WalkSpeed = data.walkSpeed
                    humanoid.JumpPower = data.jumpPower
                end
                if data.parts then
                    for _, sel in pairs(data.parts) do
                        if sel and sel.Parent then sel:Destroy() end
                    end
                end
                if data.attachment and data.attachment.Parent then
                    data.attachment:Destroy()
                end
                frozenNPCs[npc] = nil
                unfrozen = true
                showNotification("🔓 NPC Unfrozen: " .. npc.Name, Color3.fromRGB(100, 220, 255))
                break
            end
        end
        if not unfrozen then
            showNotification("No frozen NPCs nearby!", Color3.fromRGB(200, 100, 100))
        end
    end
    
    -- Revoke loyalty (R key when aiming at loyalist)
    if input.KeyCode == Enum.KeyCode.R then
        local mouse = Player:GetMouse()
        if mouse.Target then
            local model = mouse.Target:FindFirstAncestorOfClass("Model")
            if model and loyalistNPCs[model] then
                loyalistNPCs[model] = nil
                
                -- Remove crown
                local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
                if hrp then
                    for _, v in pairs(hrp:GetChildren()) do
                        if v:IsA("BillboardGui") then v:Destroy() end
                    end
                end
                
                showNotification("💔 Loyalty Revoked from: " .. model.Name, Color3.fromRGB(255, 80, 80))
            end
        end
    end
end)

