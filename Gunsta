    local direction = (mousePos - handle.Position).Unit
    
    -- Create mount beam
    local beam = Instance.new("Part")
    beam.Size = Vector3.new(0.2, 0.2, 1.0)
    beam.BrickColor = BrickColor.new("Bright orange")
    beam.Material = Enum.Material.Neon
    beam.CastShadow = false
    beam.Anchored = false
    beam.CanCollide = false
    beam.CFrame = CFrame.new(handle.Position, handle.Position + direction)
    beam.Parent = Workspace
    
    local trail = Instance.new("Trail")
    local a0 = Instance.new("Attachment")
    local a1 = Instance.new("Attachment")
    a0.Position = Vector3.new(0, 0.1, 0)
    a1.Position = Vector3.new(0, -0.1, 0)
    a0.Parent = beam
    a1.Parent = beam
    trail.Attachment0 = a0
    trail.Attachment1 = a1
    trail.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 140, 0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 220, 0))
    }
    trail.Lifetime = 0.4
    trail.Parent = beam
    
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = direction * 60
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Parent = beam
    
    local hitConn
    hitConn = beam.Touched:Connect(function(hit)
        if hit:IsDescendantOf(Character) then return end
        
        local hitModel = hit:FindFirstAncestorOfClass("Model")
        if hitModel and hitModel:FindFirstChildOfClass("Humanoid") then
            hitConn:Disconnect()
            
            -- Lasso effect
            local npcHRP = hitModel:FindFirstChild("HumanoidRootPart")
            if npcHRP then
                -- Rope visual from player to NPC
                local rope = Instance.new("RopeConstraint")
                local att0 = Instance.new("Attachment")
                local att1 = Instance.new("Attachment")
                att0.Parent = HumanoidRootPart
                att1.Parent = npcHRP
                rope.Attachment0 = att0
                rope.Attachment1 = att1
                rope.Visible = true
                rope.Color = BrickColor.new("Bright orange")
                rope.Thickness = 0.05
                rope.Length = (npcHRP.Position - HumanoidRootPart.Position).Magnitude + 2
                rope.Parent = HumanoidRootPart
                
                -- Rope reel-in effect
                task.spawn(function()
                    for i = 1, 10 do
                        rope.Length = math.max(rope.Length - 2, 0)
                        task.wait(0.1)
                    end
                    rope:Destroy()
                    att0:Destroy()
                    att1:Destroy()
                    
                    -- Mount the NPC
                    mountData = mountNPC(hitModel)
                end)
            end
            
            beam:Destroy()
        elseif hit ~= Workspace.Terrain then
            hitConn:Disconnect()
            beam:Destroy()
        end
    end)
    
    game:GetService("Debris"):AddItem(beam, 5)
    
    -- Muzzle flash
    local muzzleFlash = Instance.new("Part")
    muzzleFlash.Size = Vector3.new(0.5, 0.5, 0.5)
    muzzleFlash.BrickColor = BrickColor.new("Bright orange")
    muzzleFlash.Material = Enum.Material.Neon
    muzzleFlash.Anchored = true
    muzzleFlash.CanCollide = false
    muzzleFlash.CastShadow = false
    muzzleFlash.Shape = Enum.PartType.Ball
    muzzleFlash.CFrame = handle.CFrame * CFrame.new(0, 0, -1.3)
    muzzleFlash.Parent = Workspace
    
    TweenService:Create(muzzleFlash, TweenInfo.new(0.15), {
        Size = Vector3.new(1.2, 1.2, 1.2),
        Transparency = 1
    }):Play()
    
    game:GetService("Debris"):AddItem(muzzleFlash, 0.2)
end

