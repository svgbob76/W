-- =============================================
-- STOPMOTION BODY ANIMATION UPDATE
-- =============================================
local function applyStopMotionFrame(frameName, frameIndex)
    local animData = customAnimations[frameName]
    if not animData then return end
    
    local frames = animData.frames
    if not frames or #frames == 0 then return end
    
    local fi = ((frameIndex - 1) % #frames) + 1
    local frame = frames[fi]
    
    if motors.neck and frame.headTilt then
        motors.neck.C0 = CFrame.new(0, 1, 0) * CFrame.Angles(
            math.rad(frame.headTilt or 0),
            math.rad((frame.headRotY or 0)),
            0
        )
    end
    
    if motors.leftShoulder and frame.armL then
        motors.leftShoulder.C0 = CFrame.new(-1, 0.5, 0) * CFrame.Angles(
            math.rad(frame.armL or 0),
            0,
            math.rad(-5)
        )
    end
    
    if motors.rightShoulder and frame.armR then
        local recoilVal = frame.recoil or 0
        motors.rightShoulder.C0 = CFrame.new(1, 0.5, 0) * CFrame.Angles(
            math.rad((frame.armR or 0) + recoilVal),
            0,
            math.rad(5)
        )
    end
    
    if motors.leftHip and frame.legL then
        motors.leftHip.C0 = CFrame.new(-1, -1, 0) * CFrame.Angles(
            math.rad(frame.legL or 0),
            0, 0
        )
    end
    
    if motors.rightHip and frame.legR then
        motors.rightHip.C0 = CFrame.new(1, -1, 0) * CFrame.Angles(
            math.rad(frame.legR or 0),
            0, 0
        )
    end
    
    if motors.rootJoint and frame.torsoRotY then
        motors.rootJoint.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(
            0,
            math.rad(frame.torsoRotY or 0),
            0
        )
    end
end

