        particles.Parent = attachment
        
        -- Reduce rate after initial burst
        task.delay(2, function()
            particles.Rate = 5
        end)
    end
    
    -- Make NPC follow and protect player with basic AI
    task.spawn(function()
        local followDistance = 8
        while loyalistNPCs[npc] and npc.Parent do
            if humanoid.Health <= 0 then
                loyalistNPCs[npc] = nil
                break
            end
            
            if HumanoidRootPart then
                local dist = (npc:FindFirstChild("HumanoidRootPart") and 
                    npc.HumanoidRootPart.Position or npc.PrimaryPart and npc.PrimaryPart.Position)
                
                if dist then
                    local distFromPlayer = (dist - HumanoidRootPart.Position).Magnitude
                    
                    if distFromPlayer > followDistance then
                        -- Follow player
                        humanoid:MoveTo(HumanoidRootPart.Position)
                    else
                        -- Find enemies to fight
                        for _, otherModel in pairs(Workspace:GetChildren()) do
                            if otherModel ~= Character and otherModel ~= npc and 
                               otherModel:FindFirstChildOfClass("Humanoid") and 
                               not loyalistNPCs[otherModel] then
                                local enemyHRP = otherModel:FindFirstChild("HumanoidRootPart")
                                if enemyHRP then
                                    local enemyDist = (enemyHRP.Position - dist).Magnitude
                                    if enemyDist < 30 then
                                        humanoid:MoveTo(enemyHRP.Position)
                                        -- Damage enemy if close
                                        if enemyDist < 5 then
                                            local enemyHumanoid = otherModel:FindFirstChildOfClass("Humanoid")
                                            if enemyHumanoid then
