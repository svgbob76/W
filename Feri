local function jumpRingFx()
    local ring = makePart({
        Shape       = Enum.PartType.Cylinder,
        Size        = Vector3.new(0.2, 2, 2),
        Color       = Color3.fromRGB(255, 62, 51),
        Transparency = 0.15,
        CFrame      = CFrame.new(State.root.Position - Vector3.new(0, 3, 0))
                      * CFrame.Angles(0, 0, math.rad(90)),
    })
    tween(ring, 0.45, { Size = Vector3.new(0.2, 11, 11), Transparency = 1 })
    task.delay(0.5, function() ring:Destroy() end)
end

local function landDustFx()
    local puff = makePart({
        Size         = Vector3.new(0.2, 0.2, 0.2),
        Transparency = 1,
        CFrame       = CFrame.new(State.root.Position - Vector3.new(0, 3.1, 0)),
    })
    local em = Instance.new("ParticleEmitter")
    em.Texture    = "rbxasset://textures/particles/sparkles_main.dds"
    em.Rate       = 0
    em.Lifetime   = NumberRange.new(0.4, 0.7)
    em.Speed      = NumberRange.new(3, 6)
    em.SpreadAngle = Vector2.new(80, 80)
    em.Color      = ColorSequence.new(Color3.fromRGB(190, 198, 214), Color3.fromRGB(120, 128, 144))
    em.Size       = NumberSequence.new(0.35, 0)
    em.Parent     = puff
    em:Emit(16)
    task.delay(1.2, function() puff:Destroy() end)
end

local function attachTrail()
    if State.trail then
        State.trail:Destroy()
        State.trail = nil
    end
    local root = State.root
    local a0 = Instance.new("Attachment")
    a0.Position = Vector3.new(0, 1.2, 0)
    a0.Parent = root
    local a1 = Instance.new("Attachment")
    a1.Position = Vector3.new(0, -1.2, 0)
    a1.Parent = root

    local trail = Instance.new("Trail")
    trail.Attachment0 = a0
    trail.Attachment1 = a1
    trail.Lifetime = 0.45
    trail.LightEmission = 0.6
    trail.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(255, 62, 51)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 176, 32)),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(63, 216, 226)),
    })
    trail.Enabled = FX.Trails or FX.Cook
    trail.Parent = root
    State.trail = trail
end

local function afterimageTick(dt)
    if not FX.Afterimage or not State.character or not State.humanoid then return end
    State.ghostClock = State.ghostClock + dt
    if State.ghostClock < 0.12 then return end
    State.ghostClock = 0
    if State.humanoid.MoveDirection.Magnitude < 0.1 then return end

    local ghost = Instance.new("Model")
    ghost.Name = "Reanim8Ghost"
    for _, part in ipairs(State.character:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local g = part:Clone()
            g.CanCollide = false
            g.Material = Enum.Material.Neon
            g.Color = Color3.fromRGB(255, 82, 70)
            g.Transparency = 0.55
            g.Parent = ghost
        end
    end
    ghost.Parent = workspace
    for _, g in ipairs(ghost:GetChildren()) do
        tween(g, 0.4, { Transparency = 1 })
    end
    task.delay(0.45, function() ghost:Destroy() end)
end

RunService.Heartbeat:Connect(afterimageTick)

----------------------------------------------------------------
-- COOK MODE · everything on, everything loud
----------------------------------------------------------------
local function setCook(on)
    FX.Cook = on
    if State.trail then
        State.trail.Enabled = FX.Trails or on
    end
    if on then
        if State.root and State.root.Parent and not State.cookLight then
            local light = Instance.new("PointLight")
            light.Color = Color3.fromRGB(255, 62, 51)
            light.Brightness = 3
            light.Range = 14
            light.Parent = State.root
            State.cookLight = light
        end
        if State.root and State.root.Parent and not State.cookFire then
            local fire = Instance.new("ParticleEmitter")
            fire.Texture = "rbxasset://textures/particles/sparkles_main.dds"
            fire.Rate = 90
            fire.Lifetime = NumberRange.new(0.3, 0.6)
            fire.Speed = NumberRange.new(2, 4)
            fire.SpreadAngle = Vector2.new(30, 30)
            fire.Color = ColorSequence.new(Color3.fromRGB(255, 62, 51), Color3.fromRGB(255, 176, 32))
            fire.Size = NumberSequence.new(0.5, 0)
            fire.Parent = State.root
            State.cookFire = fire
        end
        if State.humanoid then
            State.humanoid.WalkSpeed = CONFIG.WalkSpeed * 1.6
        end
        setStatus("COOK MODE · LET HIM COOK")
    else
        if State.cookLight then State.cookLight:Destroy() State.cookLight = nil end
        if State.cookFire then State.cookFire:Destroy() State.cookFire = nil end
        if State.humanoid then
            State.humanoid.WalkSpeed = CONFIG.WalkSpeed
        end
        setStatus("COOK MODE OFF")
    end
end

