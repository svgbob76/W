-- UTILITIES
----------------------------------------------------------------
local function tween(inst, t, props, style, dir, delay)
    local info = TweenInfo.new(
        t,
        style or Enum.EasingStyle.Quart,
        dir or Enum.EasingDirection.Out,
        0, false, delay or 0
    )
    local tw = TweenService:Create(inst, info, props)
    tw:Play()
    return tw
end

local function setStatus(text)
    if State.statusLabel then
        State.statusLabel.Text = text
    end
end

local function findMotor(character, motorName)
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("Motor6D") and d.Name == motorName then
            return d
        end
    end
    return nil
end

local function makePart(props)
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.Material = Enum.Material.Neon
    for k, v in pairs(props) do
        p[k] = v
    end
    p.Parent = workspace
    return p
end

----------------------------------------------------------------
-- JOINT CACHE · names differ between R6 and R15
----------------------------------------------------------------
local JOINT_NAMES = {
    R6 = {
        Root = "RootJoint", ArmL = "Left Shoulder", ArmR = "Right Shoulder",
        HipL = "Left Hip",  HipR = "Right Hip",     Neck = "Neck",
    },
    R15 = {
        Root = "Root", ArmL = "LeftShoulder", ArmR = "RightShoulder",
        HipL = "LeftHip", HipR = "RightHip",  Neck = "Neck", Waist = "Waist",
    },
}

local function cacheJoints(character)
    State.joints, State.baseC0 = {}, {}
    for key, motorName in pairs(JOINT_NAMES[State.rig]) do
        local motor = findMotor(character, motorName)
        if motor then
            State.joints[key] = motor
            State.baseC0[motor] = motor.C0
        end
    end
end

local function restoreJoints()
    for motor, c0 in pairs(State.baseC0) do
        if motor and motor.Parent then
            motor.C0 = c0
        end
    end
end

