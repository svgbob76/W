    text.Position = UDim2.fromOffset(10, 0)
    text.BackgroundTransparency = 1
    text.Text = label
    text.Font = Enum.Font.Gotham
    text.TextSize = 11
    text.TextColor3 = C.ink
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.Parent = row

    local knobBg = Instance.new("TextButton")
    knobBg.Size = UDim2.fromOffset(36, 18)
    knobBg.Position = UDim2.new(1, -44, 0.5, -9)
    knobBg.BackgroundColor3 = C.line
    knobBg.Text = ""
    knobBg.AutoButtonColor = false
    knobBg.Parent = row
    corner(9, knobBg)

    local knob = frame(knobBg, {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = C.ink,
    })
    corner(7, knob)

    local on = initial
    local function paint()
        knobBg.BackgroundColor3 = on and C.red or C.line
        tween(knob, 0.15, {
            Position = on and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2),
        })
    end
    knobBg.MouseButton1Click:Connect(function()
        on = not on
        paint()
        onChanged(on)
    end)
    paint()
    return row
end

