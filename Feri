local refreshMoveButtons  -- forward declaration (GUI built later)

local function stopEverything()
    State.procToken = nil
    if State.track then
        pcall(function() State.track:Stop(0.15) end)
        State.track = nil
    end
    restoreJoints()
    State.playing = nil
    if refreshMoveButtons then refreshMoveButtons() end
    setStatus("IDLE · " .. State.rig .. " RIG")
end

----------------------------------------------------------------
-- PROCEDURAL ENGINE · writes Motor6D.C0 every render frame
----------------------------------------------------------------
local function startProc(kind)
    local token = {}
    State.procToken = token
    local t0 = os.clock()
    local stepName = "Reanim8Proc"
    pcall(function() RunService:UnbindFromRenderStep(stepName) end)

    RunService:BindToRenderStep(stepName, Enum.RenderPriority.Character.Value, function()
        if State.procToken ~= token then
            pcall(function() RunService:UnbindFromRenderStep(stepName) end)
            return
        end
        local t = os.clock() - t0
        local J, B = State.joints, State.baseC0

        if kind == "SPIN CYCLE" then
            if J.Root then
                J.Root.C0 = B[J.Root] * CFrame.Angles(0, t * 10, 0)
            end

        elseif kind == "GHOST HOVER" then
            if J.Root then
                J.Root.C0 = B[J.Root]
                    * CFrame.new(0, 1.2 + math.sin(t * 2.1) * 0.8, 0)
                    * CFrame.Angles(0, math.sin(t * 0.8) * 0.15, 0)
            end

        elseif kind == "NARUTO RUN" then
            local lean = math.rad(28) + math.sin(t * 16) * 0.02
            if J.Root then
                J.Root.C0 = B[J.Root] * CFrame.Angles(lean, 0, 0)
            end
            if J.ArmL then
                J.ArmL.C0 = B[J.ArmL] * CFrame.Angles(math.rad(118) + math.sin(t * 16) * 0.06, 0, math.rad(18))
            end
            if J.ArmR then
                J.ArmR.C0 = B[J.ArmR] * CFrame.Angles(math.rad(118) - math.sin(t * 16) * 0.06, 0, math.rad(-18))
            end

        elseif kind == "MOONWALK" then
            local sway = math.sin(t * 2.6)
            if J.Root then
                J.Root.C0 = B[J.Root]
                    * CFrame.new(sway * 0.5, 0, -math.abs(sway) * 0.35)
                    * CFrame.Angles(math.rad(6), sway * 0.22, 0)
            end
            if J.HipL then
                J.HipL.C0 = B[J.HipL] * CFrame.Angles(sway * 0.5, 0, 0)
            end
            if J.HipR then
                J.HipR.C0 = B[J.HipR] * CFrame.Angles(-sway * 0.5, 0, 0)
            end
        end
    end)
end

local function playMove(slot)
    local move = MOVES[slot]
    if not move or not State.humanoid then return end
    if State.playing == slot then
        stopEverything()
        return
    end
    stopEverything()

    if move.Kind == "PROC" then
        startProc(move.Name)
    else
        local anim = Instance.new("Animation")
        anim.AnimationId = move.Id
        local loader = State.animator or State.humanoid
        local ok, track = pcall(function() return loader:LoadAnimation(anim) end)
        if not ok or not track then
            setStatus("BLOCKED · you must own " .. move.Name)
            return
        end
        track.Looped = true
        track.Priority = Enum.AnimationPriority.Action
        track:Play(0.18)
        State.track = track
    end

    State.playing = slot
    if refreshMoveButtons then refreshMoveButtons() end
    setStatus("NOW PLAYING · " .. move.Name)
end

----------------------------------------------------------------
-- LOCOMOTION RE-SKIN · rewrites the stock Animate clips
----------------------------------------------------------------
local LOCO_PATHS = {
    idle1 = { "idle",  "Animation1" },
    idle2 = { "idle",  "Animation2" },
    walk  = { "walk",  "WalkAnim"   },
    run   = { "run",   "RunAnim"    },
    jump  = { "jump",  "JumpAnim"   },
    fall  = { "fall",  "FallAnim"   },
    climb = { "climb", "ClimbAnim"  },
    swim  = { "swim",  "SwimAnim"   },
    sit   = { "sit",   "SitAnim"    },
}

local function reskinLocomotion(character)
    local animate = character:FindFirstChild("Animate")
    if not animate then return end
    for key, path in pairs(LOCO_PATHS) do
        local holder = animate:FindFirstChild(path[1])
        local clip   = holder and holder:FindFirstChild(path[2])
        if clip then
            clip.AnimationId = LOCO[key]
        end
    end
end

