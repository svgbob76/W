-- CHARACTER BINDING
----------------------------------------------------------------
local function onCharacterAdded(character)
    stopEverything()
    State.cookLight, State.cookFire = nil, nil
    State.character = character

    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end
    State.humanoid = humanoid
    State.root = character:WaitForChild("HumanoidRootPart", 10)

    -- lock the rig: AUTO sniffs the Humanoid, R6/R15 forces script behavior
    if CONFIG.Rig == "AUTO" then
        State.rig = humanoid.RigType == Enum.HumanoidRigType.R6 and "R6" or "R15"
    else
        State.rig = CONFIG.Rig
    end

    -- custom movement feel per rig
    if State.rig == "R6" then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = CONFIG.JumpPower
    else
        humanoid.UseJumpPower = false
        humanoid.JumpHeight = CONFIG.JumpHeight
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = humanoid
        end
        State.animator = animator
    end
    humanoid.WalkSpeed = CONFIG.WalkSpeed

    reskinLocomotion(character)
    cacheJoints(character)
    attachTrail()

    humanoid.StateChanged:Connect(function(_, newState)
        if newState == Enum.HumanoidStateType.Jumping and FX.JumpRing then
            jumpRingFx()
        elseif newState == Enum.HumanoidStateType.Landed and FX.LandDust then
            landDustFx()
        end
    end)

    setStatus("IDLE · " .. State.rig .. " RIG LOCKED")
end

