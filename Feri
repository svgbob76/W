-- GLOBAL KEYBINDS
----------------------------------------------------------------
local SLOT_KEYS = {
    [Enum.KeyCode.One] = 1,   [Enum.KeyCode.Two] = 2,   [Enum.KeyCode.Three] = 3,
    [Enum.KeyCode.Four] = 4,  [Enum.KeyCode.Five] = 5,  [Enum.KeyCode.Six] = 6,
    [Enum.KeyCode.Seven] = 7, [Enum.KeyCode.Eight] = 8, [Enum.KeyCode.Nine] = 9,
    [Enum.KeyCode.Zero] = 10,
}

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == CONFIG.GuiKey then
        gui.Enabled = not gui.Enabled
        dockGui.Enabled = not gui.Enabled
    elseif input.KeyCode == CONFIG.CookKey then
        setCook(not FX.Cook)
    elseif input.KeyCode == CONFIG.StopKey then
        stopEverything()
    elseif input.KeyCode == CONFIG.RunKey then
        State.running = true
        if State.humanoid and not FX.Cook then
            State.humanoid.WalkSpeed = CONFIG.WalkSpeed * CONFIG.RunMultiplier
        end
    else
        local slot = SLOT_KEYS[input.KeyCode]
        if slot then playMove(slot) end
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.KeyCode == CONFIG.RunKey then
        State.running = false
        if State.humanoid and not FX.Cook then
            State.humanoid.WalkSpeed = CONFIG.WalkSpeed
        end
    end
end)

