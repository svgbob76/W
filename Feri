local function makeSlider(parent, label, min, max, value, decimals, onChanged)
    local wrap = frame(parent, {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
    })
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, -60, 0, 14)
    text.BackgroundTransparency = 1
    text.Text = label
    text.TextColor3 = C.mut
    text.Font = Enum.Font.Gotham
    text.TextSize = 11
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.Parent = wrap

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.fromOffset(56, 14)
    valueLabel.Position = UDim2.new(1, -56, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.TextColor3 = C.ink
    valueLabel.Font = Enum.Font.Code
    valueLabel.TextSize = 11
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = wrap

    local track = Instance.new("TextButton")
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0, 24)
    track.BackgroundColor3 = C.panel2
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = wrap
    corner(3, track)

    local fill = frame(track, {
        Size = UDim2.fromScale((value - min) / (max - min), 1),
        BackgroundColor3 = C.red,
    })
    corner(3, fill)

    local function fmt(v)
        if decimals then
            return tostring(math.floor(v * 10 + 0.5) / 10)
        end
        return tostring(math.floor(v + 0.5))
    end
    valueLabel.Text = fmt(value)

    local sliding = false
    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = min + (max - min) * rel
        if not decimals then v = math.floor(v + 0.5) end
        fill.Size = UDim2.fromScale(math.clamp((v - min) / (max - min), 0, 1), 1)
        valueLabel.Text = fmt(v)
        onChanged(v)
    end

    track.MouseButton1Down:Connect(function(x)
        sliding = true
        update(x)
    end)
    UIS.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
    return wrap
end

