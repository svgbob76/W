local function makeToggle(parent, label, initial, onChanged)
    local row = frame(parent, {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = C.panel2,
    })
    corner(6, row)
    local text = Instance.new("TextLabel")
